diff --git a/runtime/src/hle/excite_truck/et_prompts.cpp b/runtime/src/hle/excite_truck/et_prompts.cpp
new file mode 100644
index 0000000..c35cfa6
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_prompts.cpp
@@ -0,0 +1,54 @@
+// Excite Truck (REXE01): Xbox button prompts.
+//
+// The game draws its button prompts (the round 1, 2, A, B, +, - and D-pad icons, the replay
+// controls and so on) from ordinary textures. The port ships replacements for them as a texture
+// pack in prompts/xbox next to the executable, named the way aurora's Dolphin-style texture
+// replacement expects (tex1_<w>x<h>_<hash>_<format>.png). They are registered at a lower priority
+// than anything in UserData/texture_replacements, so a player's own pack still wins.
+//
+// "[excite_truck] xbox_prompts = false" (or the F10 Controllers checkbox) brings the Wii Remote
+// prompts back; the switch takes effect immediately.
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+#include <dolphin/gx/GXStruct.h>
+#include <aurora/texture.hpp>
+
+#include <filesystem>
+#include <mutex>
+#include <optional>
+
+namespace EtPrompts {
+namespace {
+std::mutex g_mutex;
+std::optional<aurora::texture::ReplacementGroup> g_group;
+} // namespace
+
+void Apply(bool enabled) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (!enabled) {
+        if (g_group) {
+            aurora::texture::unregister_replacements(*g_group);
+            g_group.reset();
+            RT_LOG(RT_TAG_RUNTIME) << "Xbox button prompts off" << std::endl;
+        }
+        return;
+    }
+    if (g_group) {
+        return;
+    }
+    const auto exeDir = RuntimeConfigFile::ExecutableDirectory();
+    if (!exeDir) {
+        return;
+    }
+    const std::filesystem::path root = *exeDir / "prompts" / "xbox";
+    std::error_code ec;
+    if (!std::filesystem::is_directory(root, ec)) {
+        RT_LOG(RT_TAG_RUNTIME) << "Xbox button prompts: " << root.string() << " is missing, keeping the Wii prompts"
+                               << std::endl;
+        return;
+    }
+    g_group = aurora::texture::load_replacement_directory(root, {.priority = -100});
+    RT_LOG(RT_TAG_RUNTIME) << "Xbox button prompts: " << g_group->registrations.size() << " textures" << std::endl;
+}
+} // namespace EtPrompts
