diff --git a/runtime/src/hle/excite_truck/et_hooks.cpp b/runtime/src/hle/excite_truck/et_hooks.cpp
new file mode 100644
index 0000000..fa973b6
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_hooks.cpp
@@ -0,0 +1,224 @@
+// Excite Truck (REXE01) specific hooks.
+//
+// Addresses here use the 0x8F000000 alias: guest_versions.inc maps 0x8F000000 + (ET address
+// - 0x80000000) to the Excite Truck address, so 8F05EE7C below is ET 0x8005EE7C. Mario Kart
+// builds never register these (the alias has no Mario Kart counterpart).
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <thread>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "et_perf.h"
+#include "aurora_events.h"
+#include "gx_worker.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+namespace {
+// The real WPADGetStatus body (the 0x8005EE7C entry is a one-instruction thunk to it).
+constexpr uint32_t kWpadGetStatusBody = 0x8006A940u;
+} // namespace
+
+// Boot waits for the Wii Remote library with a tight loop:
+//   do { } while (WPADGetStatus() != WPAD_STATE_SETUP);
+// On hardware, alarms and IPC replies arrive as interrupts while it spins. Here they only run when
+// something services them, so service them on each poll, then read the real status.
+extern "C" void ET_WPADGetStatus_8005ee7c(CpuContext* ctx)
+{
+    OS_HLE_ProcessAlarms(8);
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+    InvokeIndirectCpu(kWpadGetStatusBody, ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8F05EE7C, ET_WPADGetStatus_8005ee7c, (CpuContext* ctx), (ctx));
+
+// OSGetFontEncode / OSSetFontEncode (2006 SDK). The first call picks a default from the VI DTV
+// status register (0xCC00206E) on NTSC consoles, which is hardware we do not emulate. A USA console
+// with no Japanese font reports ANSI (0), so cache that default and keep the rest of the logic.
+namespace {
+constexpr uint32_t kFontEncodeAddr = 0x80558F58u;   // u16, -0x79a8(r13); 0xFFFF until first use
+constexpr uint32_t kFontParseFnAddr = 0x8055DA48u;  // -0x2eb8(r13)
+constexpr uint32_t kParseStringAnsi = 0x8005032Cu;
+constexpr uint32_t kParseStringSjis = 0x80050428u;
+
+uint16_t EnsureFontEncodeDefault()
+{
+    uint16_t encode = Memory::Read16(kFontEncodeAddr);
+    if (encode == 0xFFFFu) {
+        encode = 0;
+        Memory::Write16(kFontEncodeAddr, encode);
+        Memory::Write32(kFontParseFnAddr, kParseStringAnsi);
+    }
+    return encode;
+}
+} // namespace
+
+extern "C" void ET_OSGetFontEncode_8004fe30(CpuContext* ctx)
+{
+    ctx->gpr[3] = EnsureFontEncodeDefault();
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE30, ET_OSGetFontEncode_8004fe30, (CpuContext* ctx), (ctx));
+
+extern "C" void ET_OSSetFontEncode_8004fe84(CpuContext* ctx)
+{
+    const uint16_t previous = EnsureFontEncodeDefault();
+    const uint32_t encode = ctx->gpr[3];
+    if (encode <= 5) {
+        Memory::Write16(kFontEncodeAddr, static_cast<uint16_t>(encode));
+        if (encode >= 3) {
+            Memory::Write32(kFontParseFnAddr, kParseStringSjis);
+        }
+    }
+    ctx->gpr[3] = previous;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE84, ET_OSSetFontEncode_8004fe84, (CpuContext* ctx), (ctx));
+
+// __OSReadROM(buf, length, offset): reads the IPL boot ROM over EXI. Games only read the system
+// fonts from it (OSLoadFont), and the SDK retries forever on failure. Serve those regions from
+// Dolphin's replacement fonts (Droid Sans, Apache 2.0) bundled next to the executable; anything
+// else reads as zeros.
+namespace {
+constexpr uint32_t kRomFontSjisOffset = 0x1AFF00u;
+constexpr uint32_t kRomFontAnsiOffset = 0x1FCF00u;
+constexpr uint32_t kRomSize = 0x200000u;
+
+const std::vector<uint8_t>& IplRomImage()
+{
+    static const std::vector<uint8_t> image = [] {
+        std::vector<uint8_t> rom(kRomSize, 0);
+        auto load = [&rom](const char* name, uint32_t offset) {
+            const auto dir = RuntimeConfigFile::ExecutableDirectory();
+            if (!dir) {
+                return;
+            }
+            std::ifstream in(*dir / "fonts" / name, std::ios::binary);
+            if (!in) {
+                RT_LOGF(RT_TAG_HLE, "IPL ROM: missing fonts/%s, OSLoadFont text will be blank\n", name);
+                return;
+            }
+            std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            const size_t count = std::min<size_t>(data.size(), kRomSize - offset);
+            std::copy_n(data.begin(), count, rom.begin() + offset);
+        };
+        load("font_japanese.bin", kRomFontSjisOffset);
+        load("font_western.bin", kRomFontAnsiOffset);
+        return rom;
+    }();
+    return image;
+}
+} // namespace
+
+extern "C" void ET_OSReadROM_80052f8c(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    const int32_t length = static_cast<int32_t>(ctx->gpr[4]);
+    const uint32_t offset = ctx->gpr[5];
+    const auto& rom = IplRomImage();
+    for (int32_t i = 0; i < length; ++i) {
+        const uint32_t at = offset + static_cast<uint32_t>(i);
+        Memory::Write8(buf + static_cast<uint32_t>(i), at < rom.size() ? rom[at] : 0);
+    }
+    ctx->gpr[3] = 1; // TRUE: read completed
+}
+PPC_NATIVE_OVERRIDE_VOID(8F052F8C, ET_OSReadROM_80052f8c, (CpuContext* ctx), (ctx));
+
+// GXSetDrawDone (2006 SDK, not in the Mario Kart table). It queues a "draw done" marker; on
+// hardware the GP raises the finish interrupt when it gets there, and the SDK handler sets the
+// draw-done flag and calls the game's GXSetDrawDoneCallback callback. Excite Truck waits on that
+// callback every frame and declares the GPU hung after 10 retraces without it. Draws are applied in
+// order here, so finish the queued work and deliver the interrupt straight away.
+extern "C" void GX__DrawDone_8016eab0();
+extern "C" void GX__FinishInterruptHandler_8016ed94();
+
+namespace {
+constexpr uint32_t kGxDrawDoneFlag = 0x8055D970u;     // -0x2f90(r13)
+constexpr uint32_t kGxDrawDoneCallback = 0x8055D974u; // -0x2f8c(r13)
+} // namespace
+
+extern "C" void ET_GXSetDrawDone_80040c1c(CpuContext* ctx)
+{
+    {
+        EtPerf::Scope perfScope(EtPerf::kDrawDone);
+        if (g_etCopyDispSnapshots && GxWorker::ShouldDefer()) {
+            // Race frames: wait only until the worker has replayed the last frame up to its
+            // CopyDisp. By then every read of guest memory for it is done (its arrays were copied),
+            // so the game may draw again while the worker and aurora finish that frame.
+            GxWorker::WaitUntilDone(g_etCopyDispPos);
+            GX__FinishInterruptHandler_8016ed94();
+        } else {
+            GX__DrawDone_8016eab0();
+        }
+    }
+    EtPerf::g_drawDoneAt = std::chrono::steady_clock::now();
+    Memory::Write8(kGxDrawDoneFlag, 1);
+    const uint32_t callback = Memory::Read32(kGxDrawDoneCallback);
+    if (callback != 0) {
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F040C1C, ET_GXSetDrawDone_80040c1c, (CpuContext* ctx), (ctx));
+
+// The game's debug printf (0x802E30C8, printf-style varargs) goes to a vprintf backend that the
+// release build stubbed out. Routing it to OSReport puts the game's own diagnostics ("rmemcard:",
+// scene names, ABEND reasons) in the log.
+extern "C" void OS__Report_801a25d0(CpuContext* ctx);
+
+extern "C" void ET_DebugPrintf_802e30c8(CpuContext* ctx)
+{
+    if (std::getenv("WC_GAME_LOG")) {
+        OS__Report_801a25d0(ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F2E30C8, ET_DebugPrintf_802e30c8, (CpuContext* ctx), (ctx));
+
+// The game's command-line parser (0x80004D64). Retail builds pass it an empty string, which
+// hides developer options such as "-direct_to_track:<event>". WC_ET_ARGS fills that string.
+// The parser itself (0x800199B8) still runs as translated code; this replaces only the wrapper,
+// which also looks for "-interlude" (flag byte at r13 - 0x12C4) and returns 1.
+extern "C" void ET_ParseCommandLine_80004d64(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    if (buf != 0) {
+        if (const char* args = std::getenv("WC_ET_ARGS"); args && *args) {
+            const size_t n = std::min<size_t>(std::strlen(args), 0xFF);
+            for (size_t i = 0; i < n; ++i) Memory::Write8(buf + uint32_t(i), uint8_t(args[i]));
+            Memory::Write8(buf + uint32_t(n), 0);
+            RT_LOGF(RT_TAG_HLE, "[et] command line: %s\n", args);
+        }
+        const uint32_t r13 = ctx->gpr[13];
+        InvokeDirectCpu<0x800199B8u>(ctx);
+        for (uint32_t p = buf;; ++p) {
+            const char c = char(Memory::Read8(p));
+            if (c == 0) break;
+            if (c != '-' && c != '/') continue;
+            static const char kInterlude[] = "interlude";
+            bool match = true;
+            for (uint32_t k = 0; k < 9; ++k) {
+                if (char(Memory::Read8(p + 1 + k)) != kInterlude[k]) { match = false; break; }
+            }
+            if (match) Memory::Write8(r13 - 0x12C4, 1);
+        }
+    }
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F004D64, ET_ParseCommandLine_80004d64, (CpuContext* ctx), (ctx));
+
+// New profiles are sent straight into the tutorial. The front end (0x80247C18) compares the
+// tutorial challenges a profile has passed against this function's count of challenges in
+// tutorial contests marked "mandatory" (common.res chal_eves.val), and forces the tutorial while
+// fewer have been passed. Reporting none as mandatory skips that; the tutorial itself stays.
+extern "C" void ET_MandatoryTutorialChallenges_80161d50(CpuContext* ctx)
+{
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F161D50, ET_MandatoryTutorialChallenges_80161d50, (CpuContext* ctx), (ctx));
diff --git a/runtime/src/hle/excite_truck/et_input.cpp b/runtime/src/hle/excite_truck/et_input.cpp
new file mode 100644
index 0000000..9e09af9
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_input.cpp
@@ -0,0 +1,579 @@
+// Excite Truck (REXE01): a virtual Wii Remote driven by an Xbox-style gamepad or the keyboard.
+//
+// Excite Truck only takes a sideways Wii Remote. Rather than emulate the remote's Bluetooth
+// traffic, these hooks answer at the KPAD/WPAD library level, which is where the game reads it:
+//   - WPADProbe reports a core remote on channel 0.
+//   - WPADSetConnectCallback / WPADGetInfoAsync give the game its "remote connected" and battery
+//     callbacks.
+//   - KPADRead fills one KPADStatus from the pad: buttons plus an accelerometer vector built from
+//     the steering and air-control input.
+//   - WPADControlMotor drives gamepad rumble.
+//
+// How the game reads the remote (func_802E7DDC): buttons from KPADStatus.hold, steering from
+// acc.z (steer = clamp(-2 * acc.z, -1, 1)), and air pitch from -atan2(acc.x, -acc.y). At rest a
+// sideways remote reads acc = (0, -1, 0).
+//
+// Default layout (Chris's request). Driving: R / RT = gas (2), X or L / LT = brake (1), A = turbo (D-pad),
+// left stick X = steer, left stick Y = air control (inverted by default: push up to dip the nose;
+// "Invert air control" in the F10 controller settings), Y = Wii A (reset). A also presses 2, so
+// it answers the "press 2" boost after a crash. Menus (anything but a running race, pause
+// included): A = OK (2), B / X = back (1), left stick or D-pad move, RT/R also OK.
+// Start = pause (+), Back = minus.
+// Keyboard: arrows = steer (plus D-pad for menus while gas is up), W/S = air control, X or Enter = gas / confirm (2), Z or Backspace = brake / back (1),
+// C = turbo, P = pause (+).
+//
+// Addresses use the 0x8F000000 alias (see et_hooks.cpp).
+
+#include <cstdio>
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_keyboard.h>
+#include <SDL3/SDL_events.h>
+#include <atomic>
+#include <thread>
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+#include <chrono>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+extern "C" int g_gxFrameCount;
+
+namespace {
+
+// WPAD core button bits (KPADStatus.hold uses the same values).
+constexpr uint32_t kWpadLeft = 0x0001;
+constexpr uint32_t kWpadRight = 0x0002;
+constexpr uint32_t kWpadDown = 0x0004;
+constexpr uint32_t kWpadUp = 0x0008;
+constexpr uint32_t kWpadPlus = 0x0010;
+constexpr uint32_t kWpad2 = 0x0100;
+constexpr uint32_t kWpad1 = 0x0200;
+constexpr uint32_t kWpadB = 0x0400;
+constexpr uint32_t kWpadA = 0x0800;
+constexpr uint32_t kWpadMinus = 0x1000;
+
+// Holding the remote sideways (D-pad on the left), the D-pad direction the player sees maps to a
+// different physical button.
+constexpr uint32_t kSidewaysUp = kWpadRight;
+constexpr uint32_t kSidewaysDown = kWpadLeft;
+constexpr uint32_t kSidewaysLeft = kWpadUp;
+constexpr uint32_t kSidewaysRight = kWpadDown;
+
+constexpr uint32_t kKpadStatusSize = 0x88;
+constexpr int kChannels = 4;
+constexpr int kEmulatedChannel = 0;
+
+// Full stick = a 30 degree wheel turn (acc.z = 0.5, the game's full lock) and a 45 degree pitch.
+constexpr float kMaxSteerAccZ = 0.5f;
+constexpr float kMaxPitchRadians = 0.785398f;
+constexpr float kStickDeadzone = 0.15f;
+
+std::array<uint32_t, kChannels> g_connectCallbacks{};
+bool g_connectReported = false;
+uint32_t g_previousHold = 0;
+SDL_Gamepad* g_gamepad = nullptr;
+std::atomic<int> g_pendingTaps{0};
+
+std::atomic<bool> g_xinputTaps{false};
+
+void AddTap()
+{
+    if (g_pendingTaps.load(std::memory_order_relaxed) < 16) {
+        g_pendingTaps.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+// Counts A (and keyboard C) presses as they happen, so fast taps between two game frames count.
+bool SDLCALL CountBoostTaps(void*, SDL_Event* ev)
+{
+    const bool padTap = ev->type == SDL_EVENT_GAMEPAD_BUTTON_DOWN && ev->gbutton.button == SDL_GAMEPAD_BUTTON_SOUTH &&
+                        !g_xinputTaps.load(std::memory_order_relaxed);
+    const bool keyTap = ev->type == SDL_EVENT_KEY_DOWN && !ev->key.repeat && ev->key.scancode == SDL_SCANCODE_C;
+    if (padTap || keyTap) {
+        AddTap();
+    }
+    return true;
+}
+
+#if defined(_WIN32)
+// SDL samples the pad once per game frame, so at 30 fps a quick A tap can start and end between two
+// samples and never be seen. On Windows a small thread reads XInput every 4 ms just to count A
+// presses (Chris: some taps were lost in the crash recovery).
+struct EtXInputGamepad { WORD wButtons; BYTE bLeftTrigger, bRightTrigger; SHORT sThumbLX, sThumbLY, sThumbRX, sThumbRY; };
+struct EtXInputState { DWORD dwPacketNumber; EtXInputGamepad Gamepad; };
+using EtXInputGetState = DWORD(WINAPI*)(DWORD, EtXInputState*);
+
+void StartXInputTapThread()
+{
+    static bool started = false;
+    if (started) return;
+    started = true;
+    HMODULE lib = LoadLibraryA("xinput1_4.dll");
+    if (!lib) lib = LoadLibraryA("xinput9_1_0.dll");
+    if (!lib) return;
+    auto getState = reinterpret_cast<EtXInputGetState>(GetProcAddress(lib, "XInputGetState"));
+    if (!getState) return;
+    std::thread([getState] {
+        bool wasDown[4] = {};
+        for (;;) {
+            bool any = false;
+            for (DWORD i = 0; i < 4; ++i) {
+                EtXInputState st{};
+                if (getState(i, &st) != 0) { wasDown[i] = false; continue; }
+                any = true;
+                const bool down = (st.Gamepad.wButtons & 0x1000) != 0; // XINPUT_GAMEPAD_A
+                if (down && !wasDown[i]) AddTap();
+                wasDown[i] = down;
+            }
+            g_xinputTaps.store(any, std::memory_order_relaxed);
+            Sleep(any ? 4 : 500);
+        }
+    }).detach();
+}
+#else
+void StartXInputTapThread() {}
+#endif
+
+SDL_Gamepad* ActiveGamepad()
+{
+    if (g_gamepad != nullptr && SDL_GamepadConnected(g_gamepad)) {
+        return g_gamepad;
+    }
+    g_gamepad = nullptr;
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    if (ids != nullptr) {
+        if (count > 0) {
+            g_gamepad = SDL_OpenGamepad(ids[0]);
+        }
+        SDL_free(ids);
+    }
+    return g_gamepad;
+}
+
+float StickAxis(SDL_Gamepad* pad, SDL_GamepadAxis axis)
+{
+    const float v = static_cast<float>(SDL_GetGamepadAxis(pad, axis)) / 32767.0f;
+    if (std::fabs(v) < kStickDeadzone) {
+        return 0.0f;
+    }
+    const float sign = v < 0.0f ? -1.0f : 1.0f;
+    return sign * std::min(1.0f, (std::fabs(v) - kStickDeadzone) / (1.0f - kStickDeadzone));
+}
+
+struct RemoteInput {
+    uint32_t hold = 0;
+    float steer = 0.0f; // -1 left .. +1 right
+    float pitch = 0.0f; // -1 nose down .. +1 nose up
+    bool boostTap = false; // A (or C) held in a race
+};
+
+// Game state that decides between the driving and the menu layouts.
+//   r13-0x1DEC (float): the race simulation's time step. Non-zero while a race runs, zero in the
+//                       menus and while the race is paused.
+constexpr uint32_t kRaceTimeStep = 0x8055EB14u;
+
+float ReadF32(uint32_t addr)
+{
+    const uint32_t bits = Memory::Read32(addr);
+    float v;
+    std::memcpy(&v, &bits, sizeof(v));
+    return v;
+}
+
+// r13-0x1DE8 (float): the race clock in seconds. It stops when the race is paused or over.
+constexpr uint32_t kRaceClock = 0x8055EB18u;
+
+// The time step is not cleared when a race ends, so after returning to the menus it would still
+// read as racing (Chris: the stick stopped moving the menu cursor after a race). A race also has
+// to have its clock moving: frozen for 1.5 s means we are not in a running race.
+bool RaceRunning()
+{
+    if (!(ReadF32(kRaceTimeStep) > 0.0f)) {
+        return false;
+    }
+    static float lastClock = -1.0f;
+    static auto lastChange = std::chrono::steady_clock::now();
+    const float clock = ReadF32(kRaceClock);
+    const auto now = std::chrono::steady_clock::now();
+    static const bool traceClock = std::getenv("WC_TRACE_CLOCK") != nullptr;
+    if (traceClock) {
+        static int lastF = -1;
+        if (g_gxFrameCount != lastF) {
+            lastF = g_gxFrameCount;
+            std::fprintf(stderr, "[clk] f%d clock %.4f step %.4f\n", lastF, clock, ReadF32(kRaceTimeStep));
+        }
+    }
+    if (clock != lastClock) {
+        lastClock = clock;
+        lastChange = now;
+    }
+    return now - lastChange < std::chrono::milliseconds(1500);
+}
+
+// The left stick acts as a D-pad in menus, with some hysteresis so a held stick doesn't flicker.
+uint32_t StickAsDpad(SDL_Gamepad* pad)
+{
+    static uint32_t held = 0;
+    const float x = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTX)) / 32767.0f;
+    const float y = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTY)) / 32767.0f;
+    auto axis = [](float v, bool wasNeg, bool wasPos, bool& neg, bool& pos) {
+        const float on = 0.5f, off = 0.35f;
+        neg = v < -(wasNeg ? off : on);
+        pos = v > (wasPos ? off : on);
+    };
+    bool left, right, up, down;
+    axis(x, held & kSidewaysLeft, held & kSidewaysRight, left, right);
+    axis(y, held & kSidewaysUp, held & kSidewaysDown, up, down);
+    held = (left ? kSidewaysLeft : 0) | (right ? kSidewaysRight : 0) | (up ? kSidewaysUp : 0) |
+           (down ? kSidewaysDown : 0);
+    return held;
+}
+
+// A crash plays in slow motion: the time step drops to ~0.005-0.01 (normally 1/60 or more),
+// with single frames up to ~0.02. Enter below 0.012, leave after 15 frames in a row at normal
+// speed. During it the gas (R/RT, X) is ignored, so 2 follows A alone and every A tap is a
+// clean press (Chris's idea).
+bool InCrashSlowMotion()
+{
+    static bool crash = false;
+    static int normalRun = 0;
+    static int lastFrame = -1;
+    if (g_gxFrameCount == lastFrame) {
+        return crash;
+    }
+    lastFrame = g_gxFrameCount;
+    const float step = ReadF32(kRaceTimeStep);
+    if (!crash) {
+        if (step > 0.0f && step < 0.012f) {
+            crash = true;
+            normalRun = 0;
+        }
+    } else if (step >= 0.0165f || step <= 0.0f) {
+        if (++normalRun >= 15) crash = false;
+    } else {
+        normalRun = 0;
+    }
+    return crash;
+}
+
+RemoteInput ReadInput()
+{
+    static const bool watching = SDL_AddEventWatch(CountBoostTaps, nullptr);
+    (void)watching;
+    StartXInputTapThread();
+    RemoteInput in;
+    const bool racing = RaceRunning();
+    const bool crashSlowMotion = racing && InCrashSlowMotion();
+    const bool invertAir = RuntimeConfigFile::InvertAirControl(true);
+
+    if (SDL_Gamepad* pad = ActiveGamepad()) {
+        auto button = [pad](SDL_GamepadButton b) { return SDL_GetGamepadButton(pad, b); };
+        const bool rightTrigger = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > 8000;
+        if (!crashSlowMotion && (rightTrigger || button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER))) {
+            in.hold |= kWpad2;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_NORTH)) in.hold |= kWpadA; // "Press A to reset"
+        if (button(SDL_GAMEPAD_BUTTON_WEST) || button(SDL_GAMEPAD_BUTTON_EAST)) {
+            in.hold |= kWpad1;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_UP)) in.hold |= kSidewaysUp;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_DOWN)) in.hold |= kSidewaysDown;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_LEFT)) in.hold |= kSidewaysLeft;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT)) in.hold |= kSidewaysRight;
+        if (button(SDL_GAMEPAD_BUTTON_START)) in.hold |= kWpadPlus;
+        // Select/View: in a race it is the Wii A button ("Press A to reset" when reversing),
+        // like Y. In the menus it stays the Wii minus button.
+        if (button(SDL_GAMEPAD_BUTTON_BACK)) in.hold |= racing ? kWpadA : kWpadMinus;
+        if (racing) {
+            const bool aDown = button(SDL_GAMEPAD_BUTTON_SOUTH);
+            if (aDown) {
+                // Turbo (any D-pad direction works in a race), plus 2 so that A also answers the
+                // "press 2" boost after a crash. 2 is gas, which is held while boosting anyway.
+                in.hold |= kSidewaysUp | kWpad2;
+            }
+            in.boostTap = aDown;
+            // L / LT also brake (1), next to the gas on R / RT.
+            if (SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > 8000 ||
+                button(SDL_GAMEPAD_BUTTON_LEFT_SHOULDER)) {
+                in.hold |= kWpad1;
+            }
+            in.steer = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+            // Stick up reads negative. Inverted: stick up = nose down.
+            const float stickY = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+            in.pitch = invertAir ? stickY : -stickY;
+        } else {
+            // Menus: A is OK and the stick moves the cursor. The remote stays level, since the
+            // menus ignore the D-pad while it is tilted.
+            if (button(SDL_GAMEPAD_BUTTON_SOUTH)) in.hold |= kWpad2;
+            in.hold |= StickAsDpad(pad);
+        }
+    }
+
+    int keyCount = 0;
+    const bool* keys = SDL_GetKeyboardState(&keyCount);
+    if (keys != nullptr) {
+        auto key = [keys, keyCount](SDL_Scancode sc) { return static_cast<int>(sc) < keyCount && keys[sc]; };
+        if (!crashSlowMotion && (key(SDL_SCANCODE_X) || key(SDL_SCANCODE_RETURN))) in.hold |= kWpad2;
+        if (key(SDL_SCANCODE_Z) || key(SDL_SCANCODE_BACKSPACE)) in.hold |= kWpad1;
+        if (key(SDL_SCANCODE_C)) {
+            in.hold |= kSidewaysUp;
+            if (racing) { in.hold |= kWpad2; in.boostTap = true; }
+        }
+        if (key(SDL_SCANCODE_P)) in.hold |= kWpadPlus;
+        if (key(SDL_SCANCODE_A)) in.hold |= kWpadA;
+        if (key(SDL_SCANCODE_B)) in.hold |= kWpadB;
+        // In a race any D-pad press is turbo, so Left/Right only add D-pad presses (for the menus)
+        // while gas is not held. Steering with gas held stays pure tilt.
+        const bool gasHeld = (in.hold & kWpad2) != 0;
+        if (key(SDL_SCANCODE_LEFT)) { if (!gasHeld) in.hold |= kSidewaysLeft; in.steer = -1.0f; }
+        if (key(SDL_SCANCODE_RIGHT)) { if (!gasHeld) in.hold |= kSidewaysRight; in.steer = 1.0f; }
+        // Up/Down stay pure D-pad: the menus ignore the D-pad while the remote is tilted, so air
+        // control (pitch) lives on W/S instead.
+        if (key(SDL_SCANCODE_UP)) in.hold |= kSidewaysUp;
+        if (key(SDL_SCANCODE_DOWN)) in.hold |= kSidewaysDown;
+        if (key(SDL_SCANCODE_W)) in.pitch = invertAir ? -1.0f : 1.0f;
+        if (key(SDL_SCANCODE_S)) in.pitch = invertAir ? 1.0f : -1.0f;
+        if (!racing) in.steer = 0.0f; // keep the remote level in the menus
+    }
+    // The crash recovery counts presses of 2. Every A tap (counted from SDL events, so a tap
+    // shorter than a frame still counts) becomes one game frame with 2 pressed, preceded by one
+    // frame with 2 released when R/RT is holding 2 for gas.
+    {
+        enum class Phase { Idle, Release, Press };
+        static Phase phase = Phase::Idle;
+        static int phaseFrame = 0;
+        const int frame = g_gxFrameCount;
+        static bool lastHad2 = false;
+        static int lastFrame = -1;
+        if (phase == Phase::Idle && g_pendingTaps.load(std::memory_order_relaxed) > 0) {
+            g_pendingTaps.fetch_sub(1, std::memory_order_relaxed);
+            // If the game last saw 2 released, the tap can press 2 on this very frame.
+            // Otherwise (R held for gas) it needs one frame with 2 released first.
+            phase = (lastFrame != frame && !lastHad2) ? Phase::Press : Phase::Release;
+            phaseFrame = frame;
+        }
+        if (phase == Phase::Release) {
+            if (frame != phaseFrame) {
+                phase = Phase::Press;
+                phaseFrame = frame;
+            } else {
+                in.hold &= ~kWpad2;
+            }
+        }
+        if (phase == Phase::Press) {
+            if (frame != phaseFrame) {
+                // Start the next queued tap right away, so each tap takes two frames, not three.
+                phase = Phase::Idle;
+                if (g_pendingTaps.load(std::memory_order_relaxed) > 0) {
+                    g_pendingTaps.fetch_sub(1, std::memory_order_relaxed);
+                    phase = Phase::Release;
+                    phaseFrame = frame;
+                    in.hold &= ~kWpad2;
+                }
+            } else {
+                in.hold |= kWpad2;
+            }
+        }
+        if (lastFrame != frame) {
+            lastFrame = frame;
+            lastHad2 = (in.hold & kWpad2) != 0;
+        }
+    }
+    return in;
+}
+
+// Gravity in the remote's frame: start at rest (0, -1, 0), roll by the steering angle (moves
+// gravity onto z) and pitch by the air-control angle (moves it onto x).
+void AccelFor(const RemoteInput& in, float& x, float& y, float& z)
+{
+    z = -in.steer * kMaxSteerAccZ;
+    const float planar = std::sqrt(std::max(0.0f, 1.0f - z * z));
+    const float pitch = in.pitch * kMaxPitchRadians;
+    x = planar * std::sin(pitch);
+    y = -planar * std::cos(pitch);
+}
+
+void WriteF32(uint32_t addr, float v)
+{
+    uint32_t bits;
+    static_assert(sizeof(bits) == sizeof(v));
+    std::memcpy(&bits, &v, sizeof(bits));
+    Memory::Write32(addr, bits);
+}
+
+void ReportConnected(CpuContext* ctx)
+{
+    if (g_connectReported) {
+        return;
+    }
+    g_connectReported = true;
+    const uint32_t callback = g_connectCallbacks[kEmulatedChannel];
+    RT_LOGF(RT_TAG_HLE, "ET virtual Wii Remote connected on channel 0 (callback 0x%08X)\n", callback);
+    if (callback != 0) {
+        ctx->gpr[3] = kEmulatedChannel;
+        ctx->gpr[4] = 0; // WPAD_ERR_NONE: connected
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+
+} // namespace
+
+bool EtRaceRunningForGx()
+{
+    return RaceRunning();
+}
+
+// s32 WPADProbe(s32 chan, u32* type)
+extern "C" void ET_WPADProbe_800602dc(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t typePtr = ctx->gpr[4];
+    if (chan == kEmulatedChannel) {
+        if (typePtr != 0) {
+            Memory::Write32(typePtr, 0); // WPAD_DEV_CORE
+        }
+        ctx->gpr[3] = 0;
+    } else {
+        if (typePtr != 0) {
+            Memory::Write32(typePtr, 0xFD); // WPAD_DEV_NOT_FOUND
+        }
+        ctx->gpr[3] = static_cast<uint32_t>(-1); // WPAD_ERR_NO_CONTROLLER
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F0602DC, ET_WPADProbe_800602dc, (CpuContext* ctx), (ctx));
+
+// WPADConnectCallback WPADSetConnectCallback(s32 chan, WPADConnectCallback cb)
+extern "C" void ET_WPADSetConnectCallback_80060368(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    uint32_t previous = 0;
+    if (chan >= 0 && chan < kChannels) {
+        previous = g_connectCallbacks[chan];
+        g_connectCallbacks[chan] = ctx->gpr[4];
+    }
+    ctx->gpr[3] = previous;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F060368, ET_WPADSetConnectCallback_80060368, (CpuContext* ctx), (ctx));
+
+// s32 WPADGetInfoAsync(s32 chan, WPADInfo* info, WPADCallback cb)
+extern "C" void ET_WPADGetInfoAsync_800604e8(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t info = ctx->gpr[4];
+    const uint32_t callback = ctx->gpr[5];
+    if (chan != kEmulatedChannel) {
+        ctx->gpr[3] = static_cast<uint32_t>(-1);
+        return;
+    }
+    if (info != 0) {
+        for (uint32_t i = 0; i < 0x18; i += 4) {
+            Memory::Write32(info + i, 0);
+        }
+        Memory::Write8(info + 0x14, 4); // battery: full
+        Memory::Write8(info + 0x15, 1); // LED 1
+    }
+    if (callback != 0) {
+        ctx->gpr[3] = static_cast<uint32_t>(chan);
+        ctx->gpr[4] = 0;
+        InvokeIndirectCpu(callback, ctx);
+    }
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F0604E8, ET_WPADGetInfoAsync_800604e8, (CpuContext* ctx), (ctx));
+
+// void WPADControlMotor(s32 chan, u32 command): 1 = rumble on, 0 = off.
+extern "C" void ET_WPADControlMotor_80060684(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    const bool on = ctx->gpr[4] != 0;
+    if (chan == kEmulatedChannel) {
+        if (SDL_Gamepad* pad = ActiveGamepad()) {
+            // Hold the rumble until the game turns it off (it pulses the motor itself).
+            SDL_RumbleGamepad(pad, on ? 0x6000 : 0, on ? 0x9000 : 0, on ? 1000 : 0);
+        }
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F060684, ET_WPADControlMotor_80060684, (CpuContext* ctx), (ctx));
+
+// u8 WPADGetRadioSensitivity(s32 chan)
+extern "C" void ET_WPADGetRadioSensitivity_8005ee80(CpuContext* ctx)
+{
+    ctx->gpr[3] = ctx->gpr[3] == kEmulatedChannel ? 100u : 0u;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F05EE80, ET_WPADGetRadioSensitivity_8005ee80, (CpuContext* ctx), (ctx));
+
+// s32 KPADRead(s32 chan, KPADStatus samplingBufs[], u32 length)
+extern "C" void ET_KPADRead_80047c0c(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t buf = ctx->gpr[4];
+    const uint32_t length = ctx->gpr[5];
+    if (chan != kEmulatedChannel || buf == 0 || length == 0) {
+        ctx->gpr[3] = 0;
+        return;
+    }
+    ReportConnected(ctx);
+    static const bool traceKpad = std::getenv("WC_TRACE_KPAD") != nullptr;
+    if (traceKpad) {
+        static int lastFrame = -1, reads = 0;
+        ++reads;
+        if (g_gxFrameCount != lastFrame) {
+            RT_LOGF(RT_TAG_HLE, "KPADRead frame %d reads %d lr=%08X len=%u\n", g_gxFrameCount, reads, ctx->lr, length);
+            lastFrame = g_gxFrameCount; reads = 0;
+        }
+    }
+
+    const RemoteInput in = ReadInput();
+    const uint32_t hold = in.hold;
+    static const bool traceInput = std::getenv("WC_TRACE_INPUT") != nullptr;
+    if (hold != g_previousHold && traceInput) {
+        RT_LOGF(RT_TAG_HLE, "ET remote hold=0x%04X steer=%.2f pitch=%.2f racing=%d\n", hold, in.steer,
+                in.pitch, RaceRunning() ? 1 : 0);
+    }
+    const uint32_t trig = hold & ~g_previousHold;
+    const uint32_t release = g_previousHold & ~hold;
+    g_previousHold = hold;
+
+    float ax = 0.0f;
+    float ay = -1.0f;
+    float az = 0.0f;
+    AccelFor(in, ax, ay, az);
+
+    for (uint32_t i = 0; i < kKpadStatusSize; i += 4) {
+        Memory::Write32(buf + i, 0);
+    }
+    Memory::Write32(buf + 0x00, hold);
+    Memory::Write32(buf + 0x04, trig);
+    Memory::Write32(buf + 0x08, release);
+    WriteF32(buf + 0x0C, ax);
+    WriteF32(buf + 0x10, ay);
+    WriteF32(buf + 0x14, az);
+    WriteF32(buf + 0x18, std::sqrt(ax * ax + ay * ay + az * az)); // acc_value
+    WriteF32(buf + 0x34, 1.0f);                                    // horizon (level)
+    WriteF32(buf + 0x48, 2.0f);                                    // dist from the sensor bar
+    WriteF32(buf + 0x54, 1.0f);                                    // acc_vertical
+    // This 2006 KPAD keeps dev_type as a u32 at 0x5C (0 = core remote, no extension); the
+    // wpad_err/dpd_valid_fg/data_format bytes of later SDKs do not exist yet.
+    Memory::Write32(buf + 0x5C, 0);
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F047C0C, ET_KPADRead_80047c0c, (CpuContext* ctx), (ctx));
