+#pragma once
+// WC_ET_PERF timing buckets: nanoseconds spent in named frame phases, printed every 120 frames.
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace EtPerf {
+enum Bucket { kDrawDone, kEndFrame, kPace, kBeginFrame, kWorkerEndFrame, kWorkerCopyDisp, kEndWindow, kEndSync, kGap, kWorkerBusy, kCount };
+inline std::atomic<uint64_t> g_ns[kCount];
+inline const char* const kNames[kCount] = {"drawdone", "endframe", "pace", "beginframe", "w:endframe", "w:copydisp", "endwindow", "endsync", "drawdone->copydisp", "w:busy"};
+inline std::chrono::steady_clock::time_point g_drawDoneAt{};
+
+struct Scope {
+    Bucket bucket;
+    std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+    explicit Scope(Bucket b) : bucket(b) {}
+    ~Scope() {
+        g_ns[bucket].fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now() - start).count()),
+                               std::memory_order_relaxed);
+    }
+};
+} // namespace EtPerf
