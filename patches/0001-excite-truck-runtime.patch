diff --git a/runtime/src/hle/excite_truck/et_hooks.cpp b/runtime/src/hle/excite_truck/et_hooks.cpp
new file mode 100644
index 0000000..39d33e9
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_hooks.cpp
@@ -0,0 +1,177 @@
+// Excite Truck (REXE01) specific hooks.
+//
+// Addresses here use the 0x8F000000 alias: guest_versions.inc maps 0x8F000000 + (ET address
+// - 0x80000000) to the Excite Truck address, so 8F05EE7C below is ET 0x8005EE7C. Mario Kart
+// builds never register these (the alias has no Mario Kart counterpart).
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstdint>
+#include <fstream>
+#include <iterator>
+#include <thread>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+namespace {
+// The real WPADGetStatus body (the 0x8005EE7C entry is a one-instruction thunk to it).
+constexpr uint32_t kWpadGetStatusBody = 0x8006A940u;
+} // namespace
+
+// Boot waits for the Wii Remote library with a tight loop:
+//   do { } while (WPADGetStatus() != WPAD_STATE_SETUP);
+// On hardware, alarms and IPC replies arrive as interrupts while it spins. Here they only run when
+// something services them, so service them on each poll, then read the real status.
+extern "C" void ET_WPADGetStatus_8005ee7c(CpuContext* ctx)
+{
+    OS_HLE_ProcessAlarms(8);
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+    InvokeIndirectCpu(kWpadGetStatusBody, ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8F05EE7C, ET_WPADGetStatus_8005ee7c, (CpuContext* ctx), (ctx));
+
+// FAAttach(drive, ..., info): attaches a drive to the game's FAT file layer. Drive 0 is the SD
+// card used by the custom music player. There is no /dev/sdio here, so the real call fails and
+// boot aborts with "FAAttach fails". Report success with no card inserted; the Music folder
+// support replaces the SD path later.
+extern "C" void ET_FAAttach_800b7968(CpuContext* ctx)
+{
+    const uint32_t drive = ctx->gpr[3];
+    RT_LOGF(RT_TAG_HLE, "ET FAAttach(drive=%u) -> 0 (no SD card)\n", drive);
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F0B7968, ET_FAAttach_800b7968, (CpuContext* ctx), (ctx));
+
+// OSGetFontEncode / OSSetFontEncode (2006 SDK). The first call picks a default from the VI DTV
+// status register (0xCC00206E) on NTSC consoles, which is hardware we do not emulate. A USA console
+// with no Japanese font reports ANSI (0), so cache that default and keep the rest of the logic.
+namespace {
+constexpr uint32_t kFontEncodeAddr = 0x80558F58u;   // u16, -0x79a8(r13); 0xFFFF until first use
+constexpr uint32_t kFontParseFnAddr = 0x8055DA48u;  // -0x2eb8(r13)
+constexpr uint32_t kParseStringAnsi = 0x8005032Cu;
+constexpr uint32_t kParseStringSjis = 0x80050428u;
+
+uint16_t EnsureFontEncodeDefault()
+{
+    uint16_t encode = Memory::Read16(kFontEncodeAddr);
+    if (encode == 0xFFFFu) {
+        encode = 0;
+        Memory::Write16(kFontEncodeAddr, encode);
+        Memory::Write32(kFontParseFnAddr, kParseStringAnsi);
+    }
+    return encode;
+}
+} // namespace
+
+extern "C" void ET_OSGetFontEncode_8004fe30(CpuContext* ctx)
+{
+    ctx->gpr[3] = EnsureFontEncodeDefault();
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE30, ET_OSGetFontEncode_8004fe30, (CpuContext* ctx), (ctx));
+
+extern "C" void ET_OSSetFontEncode_8004fe84(CpuContext* ctx)
+{
+    const uint16_t previous = EnsureFontEncodeDefault();
+    const uint32_t encode = ctx->gpr[3];
+    if (encode <= 5) {
+        Memory::Write16(kFontEncodeAddr, static_cast<uint16_t>(encode));
+        if (encode >= 3) {
+            Memory::Write32(kFontParseFnAddr, kParseStringSjis);
+        }
+    }
+    ctx->gpr[3] = previous;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE84, ET_OSSetFontEncode_8004fe84, (CpuContext* ctx), (ctx));
+
+// __OSReadROM(buf, length, offset): reads the IPL boot ROM over EXI. Games only read the system
+// fonts from it (OSLoadFont), and the SDK retries forever on failure. Serve those regions from
+// Dolphin's replacement fonts (Droid Sans, Apache 2.0) bundled next to the executable; anything
+// else reads as zeros.
+namespace {
+constexpr uint32_t kRomFontSjisOffset = 0x1AFF00u;
+constexpr uint32_t kRomFontAnsiOffset = 0x1FCF00u;
+constexpr uint32_t kRomSize = 0x200000u;
+
+const std::vector<uint8_t>& IplRomImage()
+{
+    static const std::vector<uint8_t> image = [] {
+        std::vector<uint8_t> rom(kRomSize, 0);
+        auto load = [&rom](const char* name, uint32_t offset) {
+            const auto dir = RuntimeConfigFile::ExecutableDirectory();
+            if (!dir) {
+                return;
+            }
+            std::ifstream in(*dir / "fonts" / name, std::ios::binary);
+            if (!in) {
+                RT_LOGF(RT_TAG_HLE, "IPL ROM: missing fonts/%s, OSLoadFont text will be blank\n", name);
+                return;
+            }
+            std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            const size_t count = std::min<size_t>(data.size(), kRomSize - offset);
+            std::copy_n(data.begin(), count, rom.begin() + offset);
+        };
+        load("font_japanese.bin", kRomFontSjisOffset);
+        load("font_western.bin", kRomFontAnsiOffset);
+        return rom;
+    }();
+    return image;
+}
+} // namespace
+
+extern "C" void ET_OSReadROM_80052f8c(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    const int32_t length = static_cast<int32_t>(ctx->gpr[4]);
+    const uint32_t offset = ctx->gpr[5];
+    const auto& rom = IplRomImage();
+    for (int32_t i = 0; i < length; ++i) {
+        const uint32_t at = offset + static_cast<uint32_t>(i);
+        Memory::Write8(buf + static_cast<uint32_t>(i), at < rom.size() ? rom[at] : 0);
+    }
+    ctx->gpr[3] = 1; // TRUE: read completed
+}
+PPC_NATIVE_OVERRIDE_VOID(8F052F8C, ET_OSReadROM_80052f8c, (CpuContext* ctx), (ctx));
+
+// GXSetDrawDone (2006 SDK, not in the Mario Kart table). It queues a "draw done" marker; on
+// hardware the GP raises the finish interrupt when it gets there, and the SDK handler sets the
+// draw-done flag and calls the game's GXSetDrawDoneCallback callback. Excite Truck waits on that
+// callback every frame and declares the GPU hung after 10 retraces without it. Draws are applied in
+// order here, so finish the queued work and deliver the interrupt straight away.
+extern "C" void GX__DrawDone_8016eab0();
+
+namespace {
+constexpr uint32_t kGxDrawDoneFlag = 0x8055D970u;     // -0x2f90(r13)
+constexpr uint32_t kGxDrawDoneCallback = 0x8055D974u; // -0x2f8c(r13)
+} // namespace
+
+extern "C" void ET_GXSetDrawDone_80040c1c(CpuContext* ctx)
+{
+    GX__DrawDone_8016eab0();
+    Memory::Write8(kGxDrawDoneFlag, 1);
+    const uint32_t callback = Memory::Read32(kGxDrawDoneCallback);
+    if (callback != 0) {
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F040C1C, ET_GXSetDrawDone_80040c1c, (CpuContext* ctx), (ctx));
+
+// The game's debug printf (0x802E30C8, printf-style varargs) goes to a vprintf backend that the
+// release build stubbed out. Routing it to OSReport puts the game's own diagnostics ("rmemcard:",
+// scene names, ABEND reasons) in the log.
+extern "C" void OS__Report_801a25d0(CpuContext* ctx);
+
+extern "C" void ET_DebugPrintf_802e30c8(CpuContext* ctx)
+{
+    if (std::getenv("WC_GAME_LOG")) {
+        OS__Report_801a25d0(ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F2E30C8, ET_DebugPrintf_802e30c8, (CpuContext* ctx), (ctx));
diff --git a/runtime/src/hle/excite_truck/et_input.cpp b/runtime/src/hle/excite_truck/et_input.cpp
new file mode 100644
index 0000000..bdac2f8
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_input.cpp
@@ -0,0 +1,311 @@
+// Excite Truck (REXE01): a virtual Wii Remote driven by an Xbox-style gamepad or the keyboard.
+//
+// Excite Truck only takes a sideways Wii Remote. Rather than emulate the remote's Bluetooth
+// traffic, these hooks answer at the KPAD/WPAD library level, which is where the game reads it:
+//   - WPADProbe reports a core remote on channel 0.
+//   - WPADSetConnectCallback / WPADGetInfoAsync give the game its "remote connected" and battery
+//     callbacks.
+//   - KPADRead fills one KPADStatus from the pad: buttons plus an accelerometer vector built from
+//     the steering and air-control input.
+//   - WPADControlMotor drives gamepad rumble.
+//
+// How the game reads the remote (func_802E7DDC): buttons from KPADStatus.hold, steering from
+// acc.z (steer = clamp(-2 * acc.z, -1, 1)), and air pitch from -atan2(acc.x, -acc.y). At rest a
+// sideways remote reads acc = (0, -1, 0).
+//
+// Default layout (Chris's request): R / RT = gas (2), X = brake (1), A = turbo (D-pad),
+// left stick X = steer, left stick Y = air control. Menus: D-pad moves, RT/R/Y confirm (2),
+// X/B go back (1), Start = pause (+), Back = minus.
+// Keyboard: arrows = steer / air, X or Enter = gas / confirm (2), Z or Backspace = brake / back (1),
+// C = turbo, P = pause (+).
+//
+// Addresses use the 0x8F000000 alias (see et_hooks.cpp).
+
+#include <cstdio>
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_keyboard.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_log.h"
+
+namespace {
+
+// WPAD core button bits (KPADStatus.hold uses the same values).
+constexpr uint32_t kWpadLeft = 0x0001;
+constexpr uint32_t kWpadRight = 0x0002;
+constexpr uint32_t kWpadDown = 0x0004;
+constexpr uint32_t kWpadUp = 0x0008;
+constexpr uint32_t kWpadPlus = 0x0010;
+constexpr uint32_t kWpad2 = 0x0100;
+constexpr uint32_t kWpad1 = 0x0200;
+constexpr uint32_t kWpadB = 0x0400;
+constexpr uint32_t kWpadA = 0x0800;
+constexpr uint32_t kWpadMinus = 0x1000;
+
+// Holding the remote sideways (D-pad on the left), the D-pad direction the player sees maps to a
+// different physical button.
+constexpr uint32_t kSidewaysUp = kWpadRight;
+constexpr uint32_t kSidewaysDown = kWpadLeft;
+constexpr uint32_t kSidewaysLeft = kWpadUp;
+constexpr uint32_t kSidewaysRight = kWpadDown;
+
+constexpr uint32_t kKpadStatusSize = 0x88;
+constexpr int kChannels = 4;
+constexpr int kEmulatedChannel = 0;
+
+// Full stick = a 30 degree wheel turn (acc.z = 0.5, the game's full lock) and a 45 degree pitch.
+constexpr float kMaxSteerAccZ = 0.5f;
+constexpr float kMaxPitchRadians = 0.785398f;
+constexpr float kStickDeadzone = 0.15f;
+
+std::array<uint32_t, kChannels> g_connectCallbacks{};
+bool g_connectReported = false;
+uint32_t g_previousHold = 0;
+SDL_Gamepad* g_gamepad = nullptr;
+
+SDL_Gamepad* ActiveGamepad()
+{
+    if (g_gamepad != nullptr && SDL_GamepadConnected(g_gamepad)) {
+        return g_gamepad;
+    }
+    g_gamepad = nullptr;
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    if (ids != nullptr) {
+        if (count > 0) {
+            g_gamepad = SDL_OpenGamepad(ids[0]);
+        }
+        SDL_free(ids);
+    }
+    return g_gamepad;
+}
+
+float StickAxis(SDL_Gamepad* pad, SDL_GamepadAxis axis)
+{
+    const float v = static_cast<float>(SDL_GetGamepadAxis(pad, axis)) / 32767.0f;
+    if (std::fabs(v) < kStickDeadzone) {
+        return 0.0f;
+    }
+    const float sign = v < 0.0f ? -1.0f : 1.0f;
+    return sign * std::min(1.0f, (std::fabs(v) - kStickDeadzone) / (1.0f - kStickDeadzone));
+}
+
+struct RemoteInput {
+    uint32_t hold = 0;
+    float steer = 0.0f; // -1 left .. +1 right
+    float pitch = 0.0f; // -1 nose down .. +1 nose up
+};
+
+RemoteInput ReadInput()
+{
+    RemoteInput in;
+
+    if (SDL_Gamepad* pad = ActiveGamepad()) {
+        auto button = [pad](SDL_GamepadButton b) { return SDL_GetGamepadButton(pad, b); };
+        const bool rightTrigger = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > 8000;
+        if (rightTrigger || button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER) || button(SDL_GAMEPAD_BUTTON_NORTH)) {
+            in.hold |= kWpad2;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_WEST) || button(SDL_GAMEPAD_BUTTON_EAST)) {
+            in.hold |= kWpad1;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_SOUTH)) {
+            in.hold |= kSidewaysUp; // turbo: any D-pad direction works in a race
+        }
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_UP)) in.hold |= kSidewaysUp;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_DOWN)) in.hold |= kSidewaysDown;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_LEFT)) in.hold |= kSidewaysLeft;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT)) in.hold |= kSidewaysRight;
+        if (button(SDL_GAMEPAD_BUTTON_START)) in.hold |= kWpadPlus;
+        if (button(SDL_GAMEPAD_BUTTON_BACK)) in.hold |= kWpadMinus;
+        in.steer = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+        in.pitch = -StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTY); // stick up = nose up
+    }
+
+    int keyCount = 0;
+    const bool* keys = SDL_GetKeyboardState(&keyCount);
+    if (keys != nullptr) {
+        auto key = [keys, keyCount](SDL_Scancode sc) { return static_cast<int>(sc) < keyCount && keys[sc]; };
+        if (key(SDL_SCANCODE_X) || key(SDL_SCANCODE_RETURN)) in.hold |= kWpad2;
+        if (key(SDL_SCANCODE_Z) || key(SDL_SCANCODE_BACKSPACE)) in.hold |= kWpad1;
+        if (key(SDL_SCANCODE_C)) in.hold |= kSidewaysUp;
+        if (key(SDL_SCANCODE_P)) in.hold |= kWpadPlus;
+        if (key(SDL_SCANCODE_A)) in.hold |= kWpadA;
+        if (key(SDL_SCANCODE_B)) in.hold |= kWpadB;
+        if (key(SDL_SCANCODE_LEFT)) { in.hold |= kSidewaysLeft; in.steer = -1.0f; }
+        if (key(SDL_SCANCODE_RIGHT)) { in.hold |= kSidewaysRight; in.steer = 1.0f; }
+        if (key(SDL_SCANCODE_UP)) { in.hold |= kSidewaysUp; in.pitch = 1.0f; }
+        if (key(SDL_SCANCODE_DOWN)) { in.hold |= kSidewaysDown; in.pitch = -1.0f; }
+    }
+    return in;
+}
+
+// Gravity in the remote's frame: start at rest (0, -1, 0), roll by the steering angle (moves
+// gravity onto z) and pitch by the air-control angle (moves it onto x).
+void AccelFor(const RemoteInput& in, float& x, float& y, float& z)
+{
+    z = -in.steer * kMaxSteerAccZ;
+    const float planar = std::sqrt(std::max(0.0f, 1.0f - z * z));
+    const float pitch = in.pitch * kMaxPitchRadians;
+    x = planar * std::sin(pitch);
+    y = -planar * std::cos(pitch);
+}
+
+void WriteF32(uint32_t addr, float v)
+{
+    uint32_t bits;
+    static_assert(sizeof(bits) == sizeof(v));
+    std::memcpy(&bits, &v, sizeof(bits));
+    Memory::Write32(addr, bits);
+}
+
+void ReportConnected(CpuContext* ctx)
+{
+    if (g_connectReported) {
+        return;
+    }
+    g_connectReported = true;
+    const uint32_t callback = g_connectCallbacks[kEmulatedChannel];
+    RT_LOGF(RT_TAG_HLE, "ET virtual Wii Remote connected on channel 0 (callback 0x%08X)\n", callback);
+    if (callback != 0) {
+        ctx->gpr[3] = kEmulatedChannel;
+        ctx->gpr[4] = 0; // WPAD_ERR_NONE: connected
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+
+} // namespace
+
+// s32 WPADProbe(s32 chan, u32* type)
+extern "C" void ET_WPADProbe_800602dc(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    const uint32_t typePtr = ctx->gpr[4];
+    if (chan == kEmulatedChannel) {
+        if (typePtr != 0) {
+            Memory::Write32(typePtr, 0); // WPAD_DEV_CORE
+        }
+        ctx->gpr[3] = 0;
+    } else {
+        if (typePtr != 0) {
+            Memory::Write32(typePtr, 0xFD); // WPAD_DEV_NOT_FOUND
+        }
+        ctx->gpr[3] = static_cast<uint32_t>(-1); // WPAD_ERR_NO_CONTROLLER
+    }
+}
