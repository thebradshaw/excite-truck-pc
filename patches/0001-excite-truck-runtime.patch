+// caller for a moment so it gets the CPU, as the wait for the next frame does on a Wii.
+extern "C" void OS_HLE_YieldToReadyThreads(CpuContext* ctx)
+{
+    using namespace OsHleInternal;
+    if (ctx == nullptr || !Fiber::GuestFiberManager::IsInitialized()) {
