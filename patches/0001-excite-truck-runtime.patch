+// Menu textures the CPU rewrites every frame (the Bink video on the title screen and menus) are
+// read by aurora some time after GXLoadTexObj returns. By then the game may already be decoding the
+// next video frame into the same buffer, which showed up as thin horizontal lines on some PCs. So
+// outside races a texture whose data changed is copied at load time, and the worker hands aurora
+// the copy. Copies live for three frames, longer than aurora takes to read them.
+namespace EtTexSnapshots {
+thread_local uint32_t t_overrideAddr = 0;
+thread_local const void* t_overridePtr = nullptr;
+std::mutex g_mutex;
+// Only buffers rewritten in at least two different frames (video frames) are copied; a texture
+// uploaded once keeps using guest memory as before. Each video buffer gets three host copies used
+// in turn, so a pointer aurora still holds stays valid (and never freed) while newer frames are
+// written to the other two.
+struct Entry {
+    int lastFrame = -1;
+    int frames = 0;
+    uint32_t capacity = 0;
+    unsigned next = 0;
+    std::array<std::unique_ptr<uint8_t[]>, 3> bufs;
+};
+std::unordered_map<uint32_t, Entry> g_entries;
+std::vector<std::unique_ptr<uint8_t[]>> g_retired;
+
+const uint8_t* Copy(uint32_t addr, const void* src, uint32_t bytes) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    Entry& e = g_entries[addr];
+    if (e.lastFrame == g_gxFrameCount) {
+        // Second load in the same frame: reuse the copy made for this frame.
+        return e.frames >= 2 && e.capacity >= bytes ? e.bufs[(e.next + 2u) % 3u].get() : nullptr;
+    }
+    e.lastFrame = g_gxFrameCount;
+    if (++e.frames < 2) {
+        return nullptr;
+    }
+    if (bytes > e.capacity) {
+        RT_LOGF(RT_TAG_GX, "copying video texture 0x%08X (%u bytes) at each load\n", addr, bytes);
+        for (auto& b : e.bufs) {
+            if (b) g_retired.push_back(std::move(b));
+            b.reset(new uint8_t[bytes]);
+        }
+        e.capacity = bytes;
+    }
+    uint8_t* dst = e.bufs[e.next % 3u].get();
+    e.next = (e.next + 1u) % 3u;
+    std::memcpy(dst, src, bytes);
+    return dst;
+}
+
+struct Scope {
+    Scope(uint32_t addr, const void* ptr) { t_overrideAddr = addr; t_overridePtr = ptr; }
+    ~Scope() { t_overrideAddr = 0; t_overridePtr = nullptr; }
+};
+} // namespace EtTexSnapshots
