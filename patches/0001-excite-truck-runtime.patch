diff --git a/runtime/src/hle/excite_truck/et_hooks.cpp b/runtime/src/hle/excite_truck/et_hooks.cpp
new file mode 100644
index 0000000..7b95e61
--- /dev/null
+++ b/runtime/src/hle/excite_truck/et_hooks.cpp
@@ -0,0 +1,163 @@
+// Excite Truck (REXE01) specific hooks.
+//
+// Addresses here use the 0x8F000000 alias: guest_versions.inc maps 0x8F000000 + (ET address
+// - 0x80000000) to the Excite Truck address, so 8F05EE7C below is ET 0x8005EE7C. Mario Kart
+// builds never register these (the alias has no Mario Kart counterpart).
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <iterator>
+#include <thread>
+#include <vector>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+namespace {
+// The real WPADGetStatus body (the 0x8005EE7C entry is a one-instruction thunk to it).
+constexpr uint32_t kWpadGetStatusBody = 0x8006A940u;
+} // namespace
+
+// Boot waits for the Wii Remote library with a tight loop:
+//   do { } while (WPADGetStatus() != WPAD_STATE_SETUP);
+// On hardware, alarms and IPC replies arrive as interrupts while it spins. Here they only run when
+// something services them, so service them on each poll, then read the real status.
+extern "C" void ET_WPADGetStatus_8005ee7c(CpuContext* ctx)
+{
+    OS_HLE_ProcessAlarms(8);
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+    InvokeIndirectCpu(kWpadGetStatusBody, ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8F05EE7C, ET_WPADGetStatus_8005ee7c, (CpuContext* ctx), (ctx));
+
+// FAAttach(drive, ..., info): attaches a drive to the game's FAT file layer. Drive 0 is the SD
+// card used by the custom music player. There is no /dev/sdio here, so the real call fails and
+// boot aborts with "FAAttach fails". Report success with no card inserted; the Music folder
+// support replaces the SD path later.
+extern "C" void ET_FAAttach_800b7968(CpuContext* ctx)
+{
+    const uint32_t drive = ctx->gpr[3];
+    RT_LOGF(RT_TAG_HLE, "ET FAAttach(drive=%u) -> 0 (no SD card)\n", drive);
+    ctx->gpr[3] = 0;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F0B7968, ET_FAAttach_800b7968, (CpuContext* ctx), (ctx));
+
+// OSGetFontEncode / OSSetFontEncode (2006 SDK). The first call picks a default from the VI DTV
+// status register (0xCC00206E) on NTSC consoles, which is hardware we do not emulate. A USA console
+// with no Japanese font reports ANSI (0), so cache that default and keep the rest of the logic.
+namespace {
+constexpr uint32_t kFontEncodeAddr = 0x80558F58u;   // u16, -0x79a8(r13); 0xFFFF until first use
+constexpr uint32_t kFontParseFnAddr = 0x8055DA48u;  // -0x2eb8(r13)
+constexpr uint32_t kParseStringAnsi = 0x8005032Cu;
+constexpr uint32_t kParseStringSjis = 0x80050428u;
+
+uint16_t EnsureFontEncodeDefault()
+{
+    uint16_t encode = Memory::Read16(kFontEncodeAddr);
+    if (encode == 0xFFFFu) {
+        encode = 0;
+        Memory::Write16(kFontEncodeAddr, encode);
+        Memory::Write32(kFontParseFnAddr, kParseStringAnsi);
+    }
+    return encode;
+}
+} // namespace
+
+extern "C" void ET_OSGetFontEncode_8004fe30(CpuContext* ctx)
+{
+    ctx->gpr[3] = EnsureFontEncodeDefault();
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE30, ET_OSGetFontEncode_8004fe30, (CpuContext* ctx), (ctx));
+
+extern "C" void ET_OSSetFontEncode_8004fe84(CpuContext* ctx)
+{
+    const uint16_t previous = EnsureFontEncodeDefault();
+    const uint32_t encode = ctx->gpr[3];
+    if (encode <= 5) {
+        Memory::Write16(kFontEncodeAddr, static_cast<uint16_t>(encode));
+        if (encode >= 3) {
+            Memory::Write32(kFontParseFnAddr, kParseStringSjis);
+        }
+    }
+    ctx->gpr[3] = previous;
+}
+PPC_NATIVE_OVERRIDE_VOID(8F04FE84, ET_OSSetFontEncode_8004fe84, (CpuContext* ctx), (ctx));
+
+// __OSReadROM(buf, length, offset): reads the IPL boot ROM over EXI. Games only read the system
+// fonts from it (OSLoadFont), and the SDK retries forever on failure. Serve those regions from
+// Dolphin's replacement fonts (Droid Sans, Apache 2.0) bundled next to the executable; anything
+// else reads as zeros.
+namespace {
+constexpr uint32_t kRomFontSjisOffset = 0x1AFF00u;
+constexpr uint32_t kRomFontAnsiOffset = 0x1FCF00u;
+constexpr uint32_t kRomSize = 0x200000u;
+
+const std::vector<uint8_t>& IplRomImage()
+{
+    static const std::vector<uint8_t> image = [] {
+        std::vector<uint8_t> rom(kRomSize, 0);
+        auto load = [&rom](const char* name, uint32_t offset) {
+            const auto dir = RuntimeConfigFile::ExecutableDirectory();
+            if (!dir) {
+                return;
+            }
+            std::ifstream in(*dir / "fonts" / name, std::ios::binary);
+            if (!in) {
+                RT_LOGF(RT_TAG_HLE, "IPL ROM: missing fonts/%s, OSLoadFont text will be blank\n", name);
+                return;
+            }
+            std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            const size_t count = std::min<size_t>(data.size(), kRomSize - offset);
+            std::copy_n(data.begin(), count, rom.begin() + offset);
+        };
+        load("font_japanese.bin", kRomFontSjisOffset);
+        load("font_western.bin", kRomFontAnsiOffset);
+        return rom;
+    }();
+    return image;
+}
+} // namespace
+
+extern "C" void ET_OSReadROM_80052f8c(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    const int32_t length = static_cast<int32_t>(ctx->gpr[4]);
+    const uint32_t offset = ctx->gpr[5];
+    const auto& rom = IplRomImage();
+    for (int32_t i = 0; i < length; ++i) {
+        const uint32_t at = offset + static_cast<uint32_t>(i);
+        Memory::Write8(buf + static_cast<uint32_t>(i), at < rom.size() ? rom[at] : 0);
+    }
+    ctx->gpr[3] = 1; // TRUE: read completed
+}
+PPC_NATIVE_OVERRIDE_VOID(8F052F8C, ET_OSReadROM_80052f8c, (CpuContext* ctx), (ctx));
+
+// GXSetDrawDone (2006 SDK, not in the Mario Kart table). It queues a "draw done" marker; on
+// hardware the GP raises the finish interrupt when it gets there, and the SDK handler sets the
+// draw-done flag and calls the game's GXSetDrawDoneCallback callback. Excite Truck waits on that
+// callback every frame and declares the GPU hung after 10 retraces without it. Draws are applied in
+// order here, so finish the queued work and deliver the interrupt straight away.
+extern "C" void GX__DrawDone_8016eab0();
+
+namespace {
+constexpr uint32_t kGxDrawDoneFlag = 0x8055D970u;     // -0x2f90(r13)
+constexpr uint32_t kGxDrawDoneCallback = 0x8055D974u; // -0x2f8c(r13)
+} // namespace
+
+extern "C" void ET_GXSetDrawDone_80040c1c(CpuContext* ctx)
+{
+    GX__DrawDone_8016eab0();
+    Memory::Write8(kGxDrawDoneFlag, 1);
+    const uint32_t callback = Memory::Read32(kGxDrawDoneCallback);
+    if (callback != 0) {
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8F040C1C, ET_GXSetDrawDone_80040c1c, (CpuContext* ctx), (ctx));
