+// Excite Truck sets a draw-done marker and a breakpoint at the start of each frame, records the next
+// frame behind the breakpoint (token 1 at its start, token 2 at its end), waits for the draw-done
+// callback, then disables the breakpoint. Draws are applied in order here, so the GP is never
+// behind; a token is delivered when issued, except while a breakpoint is set, when it is held and
+// delivered at GXDisableBreakPt, in order, as the GP would. Mario Kart installs no token callback.
+namespace {
+std::mutex g_drawSyncMutex;
+bool g_breakPointActive = false;
+std::vector<uint16_t> g_heldTokens;
+
+// The SDK's stored token callback (-0x2f88(r13) in Excite Truck). Only known for Excite Truck.
+uint32_t GxTokenCallbackAddr()
+{
+    return ::GuestRegion::IsMarioKart() ? 0u : 0x8055D978u;
+}
+
+void DeliverDrawSyncToken(CpuContext* ctx, uint16_t token)
+{
+    const uint32_t callbackAddr = GxTokenCallbackAddr();
+    if (callbackAddr == 0 || ctx == nullptr) {
+        return;
+    }
+    uint32_t callback = 0;
+    try { callback = Memory::Read32(callbackAddr); } catch (...) { callback = 0; }
+    if (callback != 0) {
