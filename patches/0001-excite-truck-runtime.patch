+// Draw-sync tokens and FIFO breakpoints.
+//
+// GXSetDrawSync(token) queues a token; when the GP reaches it, the SDK calls the
+// GXSetDrawSyncCallback callback with the token. GXEnableBreakPt(ptr) makes the GP stop at a FIFO
+// position until GXDisableBreakPt. Games combine them to keep the GP one frame behind the CPU:
+// Excite Truck sets a draw-done marker and a breakpoint at the start of each frame, records the next
+// frame behind the breakpoint (token 1 at its start, token 2 at its end), waits for the draw-done
+// callback, then disables the breakpoint. Draws are applied in order here, so the GP is never
+// behind; a token is delivered when issued, except while a breakpoint is set, when it is held and
+// delivered at GXDisableBreakPt, in order, as the GP would. Mario Kart installs no token callback.
+namespace {
+std::mutex g_drawSyncMutex;
+bool g_breakPointActive = false;
+std::vector<uint16_t> g_heldTokens;
+
+// The SDK's stored token callback (-0x2f88(r13) in Excite Truck). Only known for Excite Truck.
+uint32_t GxTokenCallbackAddr()
+{
+    return ::GuestRegion::IsMarioKart() ? 0u : 0x8055D978u;
+}
+
+void DeliverDrawSyncToken(CpuContext* ctx, uint16_t token)
+{
+    const uint32_t callbackAddr = GxTokenCallbackAddr();
+    if (callbackAddr == 0 || ctx == nullptr) {
+        return;
+    }
+    uint32_t callback = 0;
+    try { callback = Memory::Read32(callbackAddr); } catch (...) { callback = 0; }
+    if (callback != 0) {
+        ctx->gpr[3] = token;
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+} // namespace
+
+extern "C" void GX__SetDrawSync_8016e9fc(CpuContext* ctx)
+{
+    const uint16_t token = static_cast<uint16_t>(ctx->gpr[3] & 0xFFFFu);
+    GX__SetDrawSync_8016ed08(token);
+    {
+        std::lock_guard<std::mutex> lock(g_drawSyncMutex);
+        if (g_breakPointActive) {
+            g_heldTokens.push_back(token);
+            return;
+        }
+    }
+    DeliverDrawSyncToken(ctx, token);
+}
+PPC_NATIVE_OVERRIDE_VOID(8016e9fc, GX__SetDrawSync_8016e9fc, (CpuContext* ctx), (ctx));
+
+extern "C" void GX__EnableBreakPt_8016d098(CpuContext* ctx)
+{
+    (void)ctx;
+    std::lock_guard<std::mutex> lock(g_drawSyncMutex);
+    g_breakPointActive = true;
+}
+PPC_NATIVE_OVERRIDE_VOID(8016d098, GX__EnableBreakPt_8016d098, (CpuContext* ctx), (ctx));
+
+extern "C" void GX__DisableBreakPt_8016d138(CpuContext* ctx)
+{
+    std::vector<uint16_t> tokens;
+    {
+        std::lock_guard<std::mutex> lock(g_drawSyncMutex);
+        g_breakPointActive = false;
+        tokens.swap(g_heldTokens);
+    }
+    for (const uint16_t token : tokens) {
