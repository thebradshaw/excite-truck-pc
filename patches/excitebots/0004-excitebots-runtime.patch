+// Crash recovery keeps the A button on the shaking-remote prompt, while a bar spin or the
+// dentures (same texture) show the left stick.
+const uint8_t* CrashShakeVariant(uint32_t dataAddr) {
+    return MarkedVariant(dataAddr, 0, "EBcrashA");
+}
+
+// On a bar the Push prompt (colour and mask) becomes the A button, as the input code says
+// (eb_input.cpp): one of four sizes, or (4) full size and pressed, crash recovery's second frame.
+const uint8_t* BarPromptVariant(uint32_t dataAddr, bool mask) {
+    static const char kMarks[9][9] = {"EBbarC0", "EBbarC1", "EBbarC2", "EBbarC3", "EBbarM0", "EBbarM1", "EBbarM2", "EBbarM3", "EBbarC4"};
+    const int size = EbBarHintSize();
+    const int i = mask ? 4 + (size & 3) : (size == 4 ? 8 : size & 3);
+    return MarkedVariant(dataAddr, 1 + i, kMarks[i]);
+}
