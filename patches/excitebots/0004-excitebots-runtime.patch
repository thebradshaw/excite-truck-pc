+// Excitebots builds before setup 0.3.x failed the second save of a new profile and then deleted
+// banner.bin and roam.dat, leaving only the empty inbox*.mf files. The game reports that as a
+// corrupted file on a dialog driven by the Wii Remote pointer, so a pad cannot pick "Delete file"
+// and every later session runs without saving. With neither banner.bin nor roam.dat the folder
+// holds no progress, so clear it and let the game make a new save.
+void EbRepairBrokenSave() {
+    const std::filesystem::path dir = TranslateNandPath(CurrentNandDataDir().c_str());
+    std::error_code ec;
+    if (!std::filesystem::is_directory(dir, ec)) return;
+    if (std::filesystem::exists(dir / "banner.bin", ec) || std::filesystem::exists(dir / "roam.dat", ec)) return;
+    bool any = false;
+    for (const auto& entry : std::filesystem::directory_iterator(dir, ec)) {
+        (void)entry;
+        any = true;
+        break;
+    }
+    if (!any) return;
+    std::filesystem::remove_all(dir, ec);
+    std::filesystem::create_directories(dir, ec);
+    std::fprintf(stderr, "[nand] Excitebots: cleared a save left incomplete by an older build (%s)\n",
+                 HostPathText(dir).c_str());
+}
