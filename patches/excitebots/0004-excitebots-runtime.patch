+// hardware. They are steps 0 to 10 of the boot sequence that 0x803E6CD0 runs while the main
+// thread waits (0x803E6EA0) for step 11; the step number is at 0x805A47F0 (r13-0x37F0).
+void EbRepairBrokenSave(); // hle/storage/nand_fs.cpp
