+namespace {
+// The bar prompt's sprite. 0x802C27B0 draws a 2D sprite from (x f1, y f2, z f3, scale f4 f5,
+// angle f6); it keeps them in f26 to f31 and first calls cos (0x80032990) on the angle, with the
+// sprite's texture handle (from 0x802BC6D0) in r29. The bar prompt's handle is the one in use
+// when the Push texture is loaded (gx_texture.cpp calls EbNoteBarPromptTexture).
+uint32_t g_lastSpriteHandle = 0;
+double g_lastSpriteX = 0.0;
+uint32_t g_barPromptHandle = 0;
+double g_barPromptX = 0.0;
+// The prompt's own animation pushes the remote up and down and in and out; the A stays where
+// and at the size the prompt first appeared. Its pulse is in the texture (gx_texture.cpp).
+struct HintPlace {
+    double x = 0, y = 0, z = 0, sx = 0, sy = 0;
+};
+HintPlace g_hint;
+int g_hintDraws = 0;
+int g_hintLastDraw = -1000;
+
+void BarPromptSprite(CpuContext* ctx)
+{
+    const double x = ctx->fpr[26].d;
+    g_lastSpriteHandle = ctx->gpr[29];
+    g_lastSpriteX = x;
+    // The prompt's texture pack holds other sprites too: the prompt is the one at its x.
+    if (g_barPromptHandle == 0 || ctx->gpr[29] != g_barPromptHandle || std::fabs(x - g_barPromptX) > 2.0) return;
+    static const bool trace = std::getenv("WC_EB_TRACE_HINT") != nullptr;
+    if (trace) {
+        RT_LOGF(RT_TAG_HLE, "EB hint x %.2f y %.2f z %.2f sx %.3f sy %.3f a %.3f\n", ctx->fpr[26].d, ctx->fpr[31].d,
+                ctx->fpr[30].d, ctx->fpr[27].d, ctx->fpr[28].d, ctx->fpr[29].d);
+    }
+    if (!EbBarPromptShowsA()) return;
+    ++g_hintDraws;
+    if (g_hintDraws - g_hintLastDraw > 20) {
+        g_hint = {x, ctx->fpr[31].d, ctx->fpr[30].d, ctx->fpr[27].d, ctx->fpr[28].d};
+    }
+    g_hintLastDraw = g_hintDraws;
+    // The position is already on 0x802C27B0's stack (r1 + 68) by now; the rest is in registers.
+    const uint32_t sp = ctx->gpr[1];
+    // On a red bar the A bounces as crash recovery's does (recorded from the game): down and
+    // back up twice in 0.55 s, by about half the button's height, pressed at the bottom.
+    const double y = g_hint.y + (OnRedBar() ? kRedHintDrop * RedHintBounce(ReadF32(kRaceClock)) : 0.0);
+    WriteF32(sp + 68, float(g_hint.x));
+    WriteF32(sp + 72, float(y));
+    WriteF32(sp + 76, float(g_hint.z));
+    ctx->fpr[26].d = g_hint.x;
+    ctx->fpr[31].d = y;
+    ctx->fpr[30].d = g_hint.z;
+    ctx->fpr[27].d = g_hint.sx;
+    ctx->fpr[28].d = g_hint.sy;
+    ctx->fpr[29].d = 0.0;
+    ctx->fpr[1].d = 0.0;
+}
+} // namespace
+
+void EbNoteBarPromptTexture()
+{
+    g_barPromptHandle = g_lastSpriteHandle;
+    g_barPromptX = g_lastSpriteX;
+}
+
+// cos (0x80032990, the library's fdlibm cos), replaced only to see the bar prompt's sprite
+// before it is drawn (BarPromptSprite); the result is the library's own, from its kernels.
+extern "C" void EB_cos_80032990(CpuContext* ctx)
+{
+    if (ctx->lr == 0x802C284Cu) BarPromptSprite(ctx);
+    const double x = ctx->fpr[1].d;
+    uint64_t bits;
+    std::memcpy(&bits, &x, sizeof bits);
+    const uint32_t ix = uint32_t(bits >> 32) & 0x7FFFFFFFu;
+    const uint32_t lr = ctx->lr;
+    if (ix <= 0x3FE921FBu) {
+        ctx->fpr[2].d = 0.0;
+        InvokeDirectCpu<0x80030B30u>(ctx); // __kernel_cos(x, 0)
+        ctx->lr = lr;
+        return;
+    }
+    if (ix >= 0x7FF00000u) {
+        ctx->fpr[1].d = x - x;
+        return;
+    }
+    // __ieee754_rem_pio2(x, y) with y on a stack frame of our own, as the library does.
+    const uint32_t sp = ctx->gpr[1];
+    const uint32_t frame = sp - 32;
+    Memory::Write32(frame, sp);
+    ctx->gpr[1] = frame;
+    ctx->gpr[3] = frame + 16;
+    ctx->fpr[1].d = x;
+    InvokeDirectCpu<0x800307ACu>(ctx);
+    const uint32_t n = ctx->gpr[3] & 3u;
+    auto readF64 = [](uint32_t a) {
+        const uint64_t v = (uint64_t(Memory::Read32(a)) << 32) | Memory::Read32(a + 4);
+        double d;
+        std::memcpy(&d, &v, sizeof d);
+        return d;
+    };
+    ctx->fpr[1].d = readF64(frame + 16);
+    ctx->fpr[2].d = readF64(frame + 24);
+    if (n == 0 || n == 2) {
+        InvokeDirectCpu<0x80030B30u>(ctx); // __kernel_cos
+    } else {
+        ctx->gpr[3] = 1;
+        InvokeDirectCpu<0x800322F8u>(ctx); // __kernel_sin(y0, y1, 1)
+    }
+    if (n == 1 || n == 2) ctx->fpr[1].d = -ctx->fpr[1].d;
+    ctx->gpr[1] = sp;
+    ctx->lr = lr;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E032990, EB_cos_80032990, (CpuContext* ctx), (ctx));
