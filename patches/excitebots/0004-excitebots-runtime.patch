+            } else {
+                heldReads = 0;
+            }
+            if (dir != 0) lastDir = dir;
+            if (mag < 0.3f) lastDir = 0;
+            flicked = mag > 0.7f;
+        } else {
+            flicked = mag > 0.7f;
+            heldReads = 0;
+            lastDir = 0;
+        }
+        static const bool traceShake = std::getenv("WC_EB_TRACE_SHAKE") != nullptr;
+        if (traceShake && (push != pushWasShown || push)) {
+            const uint32_t ctrl = Memory::Read32(0x805785D0u);
+            RT_LOGF(RT_TAG_HLE, "EB push %d red %d clock %.3f flick %d swing %d\n", int(push), int(EbRedBarShown()), ReadF32(kRaceClock), ctrl ? Memory::Read8(ctrl + 0x28) : -1, g_swingReadsLeft);
+        }
+        pushWasShown = push;
+        // On a bar (spinning to charge, then Push to let go) and while shaking something off,
+        // holding the gas (RT, R, X) kept some of the swings from registering, so it is ignored
+        // there. Crash recovery keeps it.
+        static const bool keepGas = std::getenv("WC_EB_GAS_ON_BARS") != nullptr;
+        if (!keepGas && (push || OnRedBar() || (shake && !crashShake))) in.hold &= ~kWpad2;
+        const int side = stickX > 0.5f ? 1 : stickX < -0.5f ? -1 : 0;
+        if (crashShake && side != 0 && side != lastSide) swingButton = true;
+        if (side != 0) lastSide = side;
+        if (actionButton && crashShake) swingButton = true;
+        // Spinning on a bar to charge (and shaking off the dentures): the game wants the remote
+        // rocked hard and fast. Steering the stick left and right rocked it, but only as fast as
+        // the player could wiggle, and forward and back did nothing, so the charge barely moved.
+        // Now the stick held in any direction (or A held) rocks the remote at full speed, which
+        // charges as fast as the best real shake.
+        static const bool stickRock = std::getenv("WC_EB_STICK_STEER_SHAKE") == nullptr;
+        // Developer aid: WC_EB_TEST_STICK=1 acts as if the stick were held over during the shake.
+        static const bool testStick = std::getenv("WC_EB_TEST_STICK") != nullptr;
+        // Round 21 (Chris: the running legs "seem wrong"; control them "in the same fashion as
+        // the Wii Remote, but with the left thumbstick, side to side"): the remote rocked side
+        // to side follows the stick, each push past a third of the way a full rock, so the legs
+        // run as fast as the stick is waggled. Holding A still rocks it at full speed by itself
+        // (the dentures), and the stick held still no longer does.
+        if (shake && !crashShake && !push) {
+            if (std::fabs(stickX) > 0.33f) {
+                in.steer = stickX > 0.0f ? 1.0f : -1.0f;
+                in.pitch = 0.0f;
+            } else if (actionButton || testStick || (!autoBars && stickRock && mag > 0.4f)) {
+                static int rock = 0;
+                in.steer = ((++rock / 3) % 2) != 0 ? 1.0f : -1.0f;
+                in.pitch = 0.0f;
+            } else {
+                in.steer = 0.0f;
+            }
+        }
+        if (traceShake && shake && !crashShake) {
+            const uint32_t ctrl = Memory::Read32(0x805785D0u);
+            static int n = 0;
+            if (ctrl && (++n % 10) == 0) RT_LOGF(RT_TAG_HLE, "EB shake %.3f %.3f steer %.2f\n", ReadF32(ctrl + 0x30), ReadF32(ctrl + 0x34), in.steer);
+        }
+    }
+    // Developer aid for testing swings without a pad: WC_EB_AUTOSWING=N swings every N reads.
+    static const int autoSwing = std::getenv("WC_EB_AUTOSWING") ? std::atoi(std::getenv("WC_EB_AUTOSWING")) : 0;
+    if (autoSwing > 0 && racing) {
+        static int reads = 0;
+        swingButton = (++reads % autoSwing) < 2;
+    }
+    // A swing asked for while one is still playing (fast stick strokes) waits for it to end and
+    // for two reads at rest, so the game's detector sees each one as its own flick.
+    static bool swingWasDown = false;
+    static bool swingPending = false;
+    static int restReads = 0;
+    if (swingButton && !swingWasDown) swingPending = true;
+    swingWasDown = swingButton;
+    if (!racing) swingPending = false;
+    if (swingPending && g_swingReadsLeft == 0 && restReads >= 2) {
+        swingPending = false;
+        g_swingReadsLeft = kSwingReads;
+        if (std::getenv("WC_TRACE_INPUT")) RT_LOGF(RT_TAG_HLE, "EB remote swing\n");
+    }
+    if (g_swingReadsLeft > 0) {
+        in.swing = kSwingReads - g_swingReadsLeft;
+        --g_swingReadsLeft;
+        restReads = 0;
+    } else {
+        ++restReads;
+    }
+    return in;
+}
+
+void AccelFor(const RemoteInput& in, float& x, float& y, float& z)
+{
+    z = -in.steer * kMaxSteerAccZ;
+    const float planar = std::sqrt(std::max(0.0f, 1.0f - z * z));
+    const float pitch = in.pitch * kMaxPitchRadians;
+    x = planar * std::sin(pitch);
+    y = -planar * std::cos(pitch);
+}
+
+void WriteF32(uint32_t addr, float v)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &v, sizeof(bits));
+    Memory::Write32(addr, bits);
+}
+
+void ReportConnected(CpuContext* ctx)
+{
+    if (g_connectReported) {
+        return;
+    }
+    // The hook may not see the game's call (a tiny leaf), so fall back to KPAD's own copy:
+    // 0x804F9E28 + chan * 0x5C0 + 0x550.
+    uint32_t callback = g_connectCallbacks[kEmulatedChannel];
+    if (callback == 0) callback = Memory::Read32(0x804F9E28u + kEmulatedChannel * 0x5C0u + 0x550u);
+    if (callback == 0) {
+        return; // not registered yet: try again on the next read
+    }
+    g_connectReported = true;
+    RT_LOGF(RT_TAG_HLE, "EB virtual Wii Remote connected on channel 0 (callback 0x%08X)\n", callback);
+    {
+        const uint32_t r3 = ctx->gpr[3], r4 = ctx->gpr[4], r5 = ctx->gpr[5], r6 = ctx->gpr[6];
+        ctx->gpr[3] = kEmulatedChannel;
+        ctx->gpr[4] = 0; // WPAD_ERR_NONE: connected
+        InvokeIndirectCpu(callback, ctx);
+        ctx->gpr[3] = r3; ctx->gpr[4] = r4; ctx->gpr[5] = r5; ctx->gpr[6] = r6;
+    }
+}
+
