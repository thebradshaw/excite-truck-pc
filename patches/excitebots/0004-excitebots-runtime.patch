diff --git a/runtime/src/hle/excitebots/eb_hooks.cpp b/runtime/src/hle/excitebots/eb_hooks.cpp
new file mode 100644
index 0000000..2aa8ac2
--- /dev/null
+++ b/runtime/src/hle/excitebots/eb_hooks.cpp
@@ -0,0 +1,147 @@
+// Excitebots: Trick Racing (RX3E01) specific hooks.
+//
+// Addresses here use the 0x8E000000 alias: guest_versions.inc maps 0x8E000000 + (EB address
+// - 0x80000000) to the Excitebots address, so 8E046A08 below is EB 0x80046A08. Other games never
+// register these (the alias only has an Excitebots counterpart).
+
+#include <algorithm>
+#include <cstdint>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <cstdlib>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_log.h"
+
+extern "C" void GX__DrawDone_8016eab0();
+extern "C" void OS__Report_801a25d0(CpuContext* ctx);
+
+namespace {
+constexpr uint32_t kGxDrawDoneFlag = 0x805A1E28u;     // -0x61b8(r13)
+constexpr uint32_t kGxDrawDoneCallback = 0x805A1E2Cu; // -0x61b4(r13)
+} // namespace
+
+// GXSetDrawDone (0x80046A08): writes a draw-done token to the FIFO and returns; the PE finish
+// interrupt then sets the flag and calls the draw-done callback. The runtime has no PE interrupt,
+// so finish the queued draws and do both here.
+extern "C" void EB_GXSetDrawDone_80046a08(CpuContext* ctx)
+{
+    GX__DrawDone_8016eab0();
+    Memory::Write8(kGxDrawDoneFlag, 1);
+    const uint32_t callback = Memory::Read32(kGxDrawDoneCallback);
+    if (callback != 0) {
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8E046A08, EB_GXSetDrawDone_80046a08, (CpuContext* ctx), (ctx));
+
+// The game parses a command line at boot (wrapper 0x80004940 -> parser 0x80022360), but retail
+// builds pass an empty string. WC_EB_ARGS supplies one, which unlocks the developer options in the
+// table at 0x804A0EE8 (-direct_to_track:<track>, -force_chassis:<bot>, -widescreen, -players:<n>,
+// -no_music, ...). The wrapper's own check for one more option has no side effects.
+extern "C" void EB_ParseCommandLine_80004940(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    if (buf != 0) {
+        if (const char* args = std::getenv("WC_EB_ARGS"); args && *args) {
+            const size_t n = std::min<size_t>(std::strlen(args), 0xFF);
+            for (size_t i = 0; i < n; ++i) Memory::Write8(buf + uint32_t(i), uint8_t(args[i]));
+            Memory::Write8(buf + uint32_t(n), 0);
+            RT_LOGF(RT_TAG_HLE, "[eb] command line: %s\n", args);
+        }
+        InvokeDirectCpu<0x80022360u>(ctx);
+    }
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E004940, EB_ParseCommandLine_80004940, (CpuContext* ctx), (ctx));
+
+// The game's debug printf (0x803EC320, varargs, ~870 callers) was stubbed out in the release
+// build. WC_GAME_LOG=1 routes it to OSReport.
+extern "C" void EB_DebugPrintf_803ec320(CpuContext* ctx)
+{
+    static const bool enabled = std::getenv("WC_GAME_LOG") != nullptr;
+    if (enabled) {
+        OS__Report_801a25d0(ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8E3EC320, EB_DebugPrintf_803ec320, (CpuContext* ctx), (ctx));
+
+// Boot waits for the Wii Remote library with a tight loop (0x803F127C):
+//   do { } while (WPADGetStatus() != WPAD_STATE_SETUP);
+// On hardware, alarms and IPC replies arrive as interrupts while it spins. Here they only run when
+// something services them, so service them on each poll, then read the real status
+// (WPADGetStatus 0x80067010 is a thunk to WUDGetStatus 0x800750B8).
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+extern "C" void EB_WPADGetStatus_80067010(CpuContext* ctx)
+{
+    OS_HLE_ProcessAlarms(8);
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+    InvokeIndirectCpu(0x800750B8u, ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8E067010, EB_WPADGetStatus_80067010, (CpuContext* ctx), (ctx));
+
+// AIStopDMA (0x800342c0). Mario Kart Wii never links it, so the runtime has no hook; on hardware it
+// clears the AI DMA enable bit (0xCC005036 bit 15), which the runtime does not map. The runtime's
+// audio output keeps running; the game restarts DMA with AIStartDMA when it wants sound again.
+extern "C" void EB_AIStopDMA_800342c0(CpuContext*) {}
+PPC_NATIVE_OVERRIDE_VOID(8E0342C0, EB_AIStopDMA_800342c0, (CpuContext* ctx), (ctx));
+
+// OSGetFontEncode (0x800570D4). The first call picks a default from the VI DTV status register
+// (0xCC00206E) on NTSC consoles, which the runtime does not emulate. A USA console with no
+// Japanese font reports ANSI (0); the rest is the SDK's own logic.
+namespace {
+constexpr uint32_t kFontEncodeAddr = 0x805A0218u;  // u16, -0x7dc8(r13); 0xFFFF until first use
+constexpr uint32_t kFontParseFnAddr = 0x805A1EE8u; // -0x60f8(r13)
+constexpr uint32_t kParseStringAnsi = 0x800575D0u;
+} // namespace
+
+extern "C" void EB_OSGetFontEncode_800570d4(CpuContext* ctx)
+{
+    uint16_t encode = Memory::Read16(kFontEncodeAddr);
+    if (encode == 0xFFFFu) {
+        encode = 0;
+        Memory::Write16(kFontEncodeAddr, encode);
+        Memory::Write32(kFontParseFnAddr, kParseStringAnsi);
+    }
+    ctx->gpr[3] = encode;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E0570D4, EB_OSGetFontEncode_800570d4, (CpuContext* ctx), (ctx));
+
+// __OSReadROM (0x8005A708): the system fonts from the IPL ROM, served from the bundled
+// replacement fonts by the Excite Truck hook (et_hooks.cpp), which is game-independent.
+extern "C" void ET_OSReadROM_80052f8c(CpuContext* ctx);
+
+extern "C" void EB_OSReadROM_8005a708(CpuContext* ctx)
+{
+    ET_OSReadROM_80052f8c(ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8E05A708, EB_OSReadROM_8005a708, (CpuContext* ctx), (ctx));
+
+// NANDCreateAsync (0x800AF158) and NANDCreateDirAsync (0x800AF900): the public async calls, which
+// Mario Kart never links. Same arguments as the private ones the runtime implements.
+extern "C" int32_t NANDPrivateCreateAsync_HLE(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                              uint32_t commandBlockPtr);
+extern "C" int32_t NANDPrivateCreateDirAsync_HLE(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                                 uint32_t commandBlockPtr);
+
+extern "C" int32_t EB_NANDCreateAsync_800af158(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                               uint32_t commandBlockPtr)
+{
+    return NANDPrivateCreateAsync_HLE(pathPtr, perm, attr, callbackPtr, commandBlockPtr);
+}
+PPC_NATIVE_OVERRIDE(8E0AF158, EB_NANDCreateAsync_800af158, int32_t,
+    (uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr, uint32_t commandBlockPtr),
+    (pathPtr, perm, attr, callbackPtr, commandBlockPtr));
+
+extern "C" int32_t EB_NANDCreateDirAsync_800af900(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                                  uint32_t commandBlockPtr)
+{
+    return NANDPrivateCreateDirAsync_HLE(pathPtr, perm, attr, callbackPtr, commandBlockPtr);
+}
+PPC_NATIVE_OVERRIDE(8E0AF900, EB_NANDCreateDirAsync_800af900, int32_t,
+    (uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr, uint32_t commandBlockPtr),
+    (pathPtr, perm, attr, callbackPtr, commandBlockPtr));
diff --git a/runtime/src/hle/excitebots/eb_input.cpp b/runtime/src/hle/excitebots/eb_input.cpp
new file mode 100644
index 0000000..ca60626
--- /dev/null
+++ b/runtime/src/hle/excitebots/eb_input.cpp
@@ -0,0 +1,267 @@
+// Excitebots (RX3E01): a virtual sideways Wii Remote driven by an Xbox-style gamepad or the
+// keyboard, answered at the KPAD level like Excite Truck (see et_input.cpp).
+//   - KPADSetConnectCallback (0x8004E984) is recorded; the first KPADRead reports channel 0 as
+//     connected through it, which is how the game's input layer (0x803F10E0) marks a remote.
+//   - KPADReadEx (0x8004DABC; KPADRead 0x8004DAB0 jumps to it) fills one KPADStatus.
+//   - WPADProbe (0x8006830C) reports a core remote on channel 0.
+// The game reads one KPADStatus per channel per frame (0x803F1C54) into 0x8059BAB8 + chan*0xCB0.
+//
+// Addresses use the 0x8E000000 alias (see eb_hooks.cpp).
+
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_keyboard.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+namespace {
+
+constexpr uint32_t kWpadLeft = 0x0001;
+constexpr uint32_t kWpadRight = 0x0002;
+constexpr uint32_t kWpadDown = 0x0004;
+constexpr uint32_t kWpadUp = 0x0008;
+constexpr uint32_t kWpadPlus = 0x0010;
+constexpr uint32_t kWpad2 = 0x0100;
+constexpr uint32_t kWpad1 = 0x0200;
+constexpr uint32_t kWpadB = 0x0400;
+constexpr uint32_t kWpadA = 0x0800;
+constexpr uint32_t kWpadMinus = 0x1000;
+constexpr uint32_t kWpadHome = 0x8000;
+
+// Held sideways (D-pad on the left).
+constexpr uint32_t kSidewaysUp = kWpadRight;
+constexpr uint32_t kSidewaysDown = kWpadLeft;
+constexpr uint32_t kSidewaysLeft = kWpadUp;
+constexpr uint32_t kSidewaysRight = kWpadDown;
+
+constexpr uint32_t kKpadStatusSize = 0x84; // 2008 KPADStatus
+constexpr int kChannels = 4;
+constexpr int kEmulatedChannel = 0;
+
+constexpr float kMaxSteerAccZ = 0.5f;
+constexpr float kMaxPitchRadians = 0.785398f;
+constexpr float kStickDeadzone = 0.15f;
+
+std::array<uint32_t, kChannels> g_connectCallbacks{};
+bool g_connectReported = false;
+uint32_t g_previousHold = 0;
+SDL_Gamepad* g_gamepad = nullptr;
+
+SDL_Gamepad* ActiveGamepad()
+{
+    if (g_gamepad != nullptr && SDL_GamepadConnected(g_gamepad)) {
+        return g_gamepad;
+    }
+    g_gamepad = nullptr;
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    if (ids != nullptr) {
+        if (count > 0) {
+            g_gamepad = SDL_OpenGamepad(ids[0]);
+        }
+        SDL_free(ids);
+    }
+    return g_gamepad;
+}
+
+float StickAxis(SDL_Gamepad* pad, SDL_GamepadAxis axis)
+{
+    const float v = static_cast<float>(SDL_GetGamepadAxis(pad, axis)) / 32767.0f;
+    if (std::fabs(v) < kStickDeadzone) {
+        return 0.0f;
+    }
+    const float sign = v < 0.0f ? -1.0f : 1.0f;
+    return sign * std::min(1.0f, (std::fabs(v) - kStickDeadzone) / (1.0f - kStickDeadzone));
+}
+
+struct RemoteInput {
+    uint32_t hold = 0;
+    float steer = 0.0f; // -1 left .. +1 right
+    float pitch = 0.0f; // -1 nose down .. +1 nose up
+};
+
+uint32_t StickAsDpad(SDL_Gamepad* pad)
+{
+    static uint32_t held = 0;
+    const float x = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTX)) / 32767.0f;
+    const float y = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTY)) / 32767.0f;
+    auto axis = [](float v, bool wasNeg, bool wasPos, bool& neg, bool& pos) {
+        const float on = 0.5f, off = 0.35f;
+        neg = v < -(wasNeg ? off : on);
+        pos = v > (wasPos ? off : on);
+    };
+    bool left, right, up, down;
+    axis(x, held & kSidewaysLeft, held & kSidewaysRight, left, right);
+    axis(y, held & kSidewaysUp, held & kSidewaysDown, up, down);
+    held = (left ? kSidewaysLeft : 0) | (right ? kSidewaysRight : 0) | (up ? kSidewaysUp : 0) |
+           (down ? kSidewaysDown : 0);
+    return held;
+}
+
+// TODO(race state): Excite Truck switches between a driving and a menu layout on the race time
+// step; Excitebots' equivalent is not mapped yet, so the stick both steers and moves menus.
+RemoteInput ReadInput()
+{
+    RemoteInput in;
+    const bool invertAir = RuntimeConfigFile::InvertAirControl(true);
+    if (SDL_Gamepad* pad = ActiveGamepad()) {
+        auto button = [pad](SDL_GamepadButton b) { return SDL_GetGamepadButton(pad, b); };
+        if (SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > 8000 ||
+            button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER) || button(SDL_GAMEPAD_BUTTON_SOUTH)) {
+            in.hold |= kWpad2;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_WEST) || button(SDL_GAMEPAD_BUTTON_EAST) ||
+            SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > 8000 ||
+            button(SDL_GAMEPAD_BUTTON_LEFT_SHOULDER)) {
+            in.hold |= kWpad1;
+        }
+        if (button(SDL_GAMEPAD_BUTTON_NORTH)) in.hold |= kWpadA;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_UP)) in.hold |= kSidewaysUp;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_DOWN)) in.hold |= kSidewaysDown;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_LEFT)) in.hold |= kSidewaysLeft;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT)) in.hold |= kSidewaysRight;
+        if (button(SDL_GAMEPAD_BUTTON_START)) in.hold |= kWpadPlus;
+        if (button(SDL_GAMEPAD_BUTTON_BACK)) in.hold |= kWpadMinus;
+        if (button(SDL_GAMEPAD_BUTTON_GUIDE)) in.hold |= kWpadHome;
+        in.hold |= StickAsDpad(pad);
+        in.steer = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+        const float stickY = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+        in.pitch = invertAir ? stickY : -stickY;
+    }
+    int keyCount = 0;
+    const bool* keys = SDL_GetKeyboardState(&keyCount);
+    if (keys != nullptr) {
+        auto key = [keys, keyCount](SDL_Scancode sc) { return static_cast<int>(sc) < keyCount && keys[sc]; };
+        if (key(SDL_SCANCODE_X) || key(SDL_SCANCODE_RETURN)) in.hold |= kWpad2;
+        if (key(SDL_SCANCODE_Z) || key(SDL_SCANCODE_BACKSPACE)) in.hold |= kWpad1;
+        if (key(SDL_SCANCODE_C)) in.hold |= kSidewaysUp;
+        if (key(SDL_SCANCODE_P)) in.hold |= kWpadPlus;
+        if (key(SDL_SCANCODE_A)) in.hold |= kWpadA;
+        if (key(SDL_SCANCODE_B)) in.hold |= kWpadB;
+        if (key(SDL_SCANCODE_UP)) in.hold |= kSidewaysUp;
+        if (key(SDL_SCANCODE_DOWN)) in.hold |= kSidewaysDown;
+        if (key(SDL_SCANCODE_LEFT)) { in.hold |= kSidewaysLeft; in.steer = -1.0f; }
+        if (key(SDL_SCANCODE_RIGHT)) { in.hold |= kSidewaysRight; in.steer = 1.0f; }
+        if (key(SDL_SCANCODE_W)) in.pitch = invertAir ? -1.0f : 1.0f;
+        if (key(SDL_SCANCODE_S)) in.pitch = invertAir ? 1.0f : -1.0f;
+    }
+    return in;
+}
+
+void AccelFor(const RemoteInput& in, float& x, float& y, float& z)
+{
+    z = -in.steer * kMaxSteerAccZ;
+    const float planar = std::sqrt(std::max(0.0f, 1.0f - z * z));
+    const float pitch = in.pitch * kMaxPitchRadians;
+    x = planar * std::sin(pitch);
+    y = -planar * std::cos(pitch);
+}
+
+void WriteF32(uint32_t addr, float v)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &v, sizeof(bits));
+    Memory::Write32(addr, bits);
+}
+
+void ReportConnected(CpuContext* ctx)
+{
+    if (g_connectReported) {
+        return;
+    }
+    // The hook may not see the game's call (a tiny leaf), so fall back to KPAD's own copy:
+    // 0x804F9E28 + chan * 0x5C0 + 0x550.
+    uint32_t callback = g_connectCallbacks[kEmulatedChannel];
+    if (callback == 0) callback = Memory::Read32(0x804F9E28u + kEmulatedChannel * 0x5C0u + 0x550u);
+    if (callback == 0) {
+        return; // not registered yet: try again on the next read
+    }
+    g_connectReported = true;
+    RT_LOGF(RT_TAG_HLE, "EB virtual Wii Remote connected on channel 0 (callback 0x%08X)\n", callback);
+    {
+        const uint32_t r3 = ctx->gpr[3], r4 = ctx->gpr[4], r5 = ctx->gpr[5], r6 = ctx->gpr[6];
+        ctx->gpr[3] = kEmulatedChannel;
+        ctx->gpr[4] = 0; // WPAD_ERR_NONE: connected
+        InvokeIndirectCpu(callback, ctx);
+        ctx->gpr[3] = r3; ctx->gpr[4] = r4; ctx->gpr[5] = r5; ctx->gpr[6] = r6;
+    }
+}
+
+} // namespace
+
+// void KPADSetConnectCallback(s32 chan, KPADConnectCallback cb)
+extern "C" void EB_KPADSetConnectCallback_8004e984(CpuContext* ctx)
+{
+    const int32_t chan = static_cast<int32_t>(ctx->gpr[3]);
+    if (chan >= 0 && chan < kChannels) {
+        g_connectCallbacks[chan] = ctx->gpr[4];
+    }
+}
