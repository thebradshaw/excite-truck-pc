+}
+
+// The crash meter (crash recovery).
+bool EbCrashMeterShown() {
+    return g_gxFrameCount - EbScreenTextures::g_lastCrashMeter.load(std::memory_order_relaxed) <= 3;
+}
+
+// The pushed remote: let go of a bar.
+bool EbPushPromptShown() {
+    return g_gxFrameCount - EbScreenTextures::g_lastPush.load(std::memory_order_relaxed) <= 3;
+}
+
+// A red (horizontal) bar: the racer swings round it and thrusts fill its meter.
+bool EbRedBarShown() {
+    return g_gxFrameCount - EbScreenTextures::g_lastRedBar.load(std::memory_order_relaxed) <= 3;
+}
+
+// A menu's button bar (Back / OK) is on screen: pause, tutorial cards, results.
+bool EbMenuButtonsShown() {
+    return g_gxFrameCount - EbScreenTextures::g_lastMenuButton.load(std::memory_order_relaxed) <= 3;
+}
+
+// Frames the Wii Remote / Wii Wheel choice has been on screen, or -1 when it is not shown.
+int EbControllerTypeScreenFrames() {
+    using namespace EbScreenTextures;
+    const int now = g_gxFrameCount;
+    if (now - g_lastControllerType.load(std::memory_order_relaxed) > 3) return -1;
+    return now - g_firstControllerType.load(std::memory_order_relaxed);
+}
