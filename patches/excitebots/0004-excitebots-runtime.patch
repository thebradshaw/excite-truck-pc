diff --git a/runtime/src/hle/excitebots/eb_achievement_rules.inc b/runtime/src/hle/excitebots/eb_achievement_rules.inc
new file mode 100644
index 0000000..1411313
--- /dev/null
+++ b/runtime/src/hle/excitebots/eb_achievement_rules.inc
@@ -0,0 +1,68 @@
+// Game state read by the rules (Excitebots RX3E01).
+// The game keeps its own stunt tallies for its in-game Achievements screen (achievements.val):
+// *(0x805A1A0C) (r13-0x65D4) points at a block holding, for each of its 19 categories, the
+// count saved on the Wii (+0x1C + 4*c) and the count earned since boot (+0x68 + 4*c). The
+// category order is fixed by the table at 0x804A0BC8 (air, drift, tree_run, 360, car_throw,
+// jump_combo, car_smash, token, hammer, bomb, chomp, walk_smash, lumberjack, rings, yellow_bar,
+// red_bar, back_flip, sandwich, victory1). The function that adds to them is 0x8001C810; its
+// callers (0x80193xxx) also require the player state at +0x1F0 to be 0x50, which the
+// -direct_to_track developer races never reach (they sit at 0x51), so test in a normal race.
+namespace eb {
+constexpr uint32_t kTallyPointer = 0x805A1A0C;
+constexpr int kCategories = 19;
+
+struct Rule {
+    const char* id;
+    int category;
+    int count;
+};
+constexpr Rule kRules[] = {
+    {"air", 0, 1},         {"air_100", 0, 100},  {"drift", 1, 1},       {"drift_100", 1, 100},
+    {"tree_run", 2, 1},    {"spin_360", 3, 1},   {"car_throw", 4, 1},   {"jump_combo", 5, 1},
+    {"car_smash", 6, 1},   {"tokens_100", 7, 100}, {"hammer", 8, 1},    {"bomb", 9, 1},
+    {"chomp", 10, 1},      {"walk_smash", 11, 1}, {"lumberjack", 12, 1}, {"rings", 13, 1},
+    {"yellow_bar", 14, 1}, {"red_bar", 15, 1},   {"back_flip", 16, 1},  {"sandwich", 17, 1},
+    {"victory", 18, 1},    {"victory_10", 18, 10},
+};
+
+int g_frames = 0;
+int g_last[kCategories] = {};
+
+void EvaluateRules() {
+    if (++g_frames % 15 != 0) {
+        return;
+    }
+    const uint32_t block = Memory::Read32(kTallyPointer);
+    if (block < 0x80000000u || block >= 0x817FFF00u || (block & 3) != 0) {
+        return;
+    }
+    int totals[kCategories];
+    for (int c = 0; c < kCategories; ++c) {
+        const int saved = static_cast<int32_t>(Memory::Read32(block + 0x1C + 4 * c));
+        const int session = static_cast<int32_t>(Memory::Read32(block + 0x68 + 4 * c));
+        if (saved < 0 || session < 0 || saved > 10000000 || session > 10000000) {
+            return; // not the tally block (yet)
+        }
+        totals[c] = saved + session;
+    }
+    static const bool trace = std::getenv("WC_EB_TRACE_ACH") != nullptr;
+    for (int c = 0; c < kCategories; ++c) {
+        if (trace && totals[c] != g_last[c]) {
+            std::fprintf(stderr, "[achievements] category %d: %d\n", c, totals[c]);
+        }
+        g_last[c] = totals[c];
+    }
+    for (const Rule& r : kRules) {
+        if (totals[r.category] >= r.count) {
+            Unlock(r.id);
+        }
+    }
+    bool every = true;
+    for (int c = 0; c <= 17; ++c) {
+        every = every && totals[c] >= 1;
+    }
+    if (every) {
+        Unlock("trick_master");
+    }
+}
+} // namespace eb
diff --git a/runtime/src/hle/excitebots/eb_hooks.cpp b/runtime/src/hle/excitebots/eb_hooks.cpp
new file mode 100644
index 0000000..618e902
--- /dev/null
+++ b/runtime/src/hle/excitebots/eb_hooks.cpp
@@ -0,0 +1,164 @@
+// Excitebots: Trick Racing (RX3E01) specific hooks.
+//
+// Addresses here use the 0x8E000000 alias: guest_versions.inc maps 0x8E000000 + (EB address
+// - 0x80000000) to the Excitebots address, so 8E046A08 below is EB 0x80046A08. Other games never
+// register these (the alias only has an Excitebots counterpart).
+
+#include <algorithm>
+#include <cstdint>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <cstdlib>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_log.h"
+
+extern "C" void GX__DrawDone_8016eab0();
+extern "C" void OS__Report_801a25d0(CpuContext* ctx);
+
+namespace {
+constexpr uint32_t kGxDrawDoneFlag = 0x805A1E28u;     // -0x61b8(r13)
+constexpr uint32_t kGxDrawDoneCallback = 0x805A1E2Cu; // -0x61b4(r13)
+} // namespace
+
+// GXSetDrawDone (0x80046A08): writes a draw-done token to the FIFO and returns; the PE finish
+// interrupt then sets the flag and calls the draw-done callback. The runtime has no PE interrupt,
+// so finish the queued draws and do both here.
+extern "C" void EB_GXSetDrawDone_80046a08(CpuContext* ctx)
+{
+    GX__DrawDone_8016eab0();
+    Memory::Write8(kGxDrawDoneFlag, 1);
+    const uint32_t callback = Memory::Read32(kGxDrawDoneCallback);
+    if (callback != 0) {
+        InvokeIndirectCpu(callback, ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8E046A08, EB_GXSetDrawDone_80046a08, (CpuContext* ctx), (ctx));
+
+// The game parses a command line at boot (wrapper 0x80004940 -> parser 0x80022360), but retail
+// builds pass an empty string. WC_EB_ARGS supplies one, which unlocks the developer options in the
+// table at 0x804A0EE8 (-direct_to_track:<track>, -force_chassis:<bot>, -widescreen, -players:<n>,
+// -no_music, ...). The wrapper's own check for one more option has no side effects.
+extern "C" void EB_ParseCommandLine_80004940(CpuContext* ctx)
+{
+    const uint32_t buf = ctx->gpr[3];
+    if (buf != 0) {
+        if (const char* args = std::getenv("WC_EB_ARGS"); args && *args) {
+            const size_t n = std::min<size_t>(std::strlen(args), 0xFF);
+            for (size_t i = 0; i < n; ++i) Memory::Write8(buf + uint32_t(i), uint8_t(args[i]));
+            Memory::Write8(buf + uint32_t(n), 0);
+            RT_LOGF(RT_TAG_HLE, "[eb] command line: %s\n", args);
+        }
+        InvokeDirectCpu<0x80022360u>(ctx);
+    }
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E004940, EB_ParseCommandLine_80004940, (CpuContext* ctx), (ctx));
+
+// The game's debug printf (0x803EC320, varargs, ~870 callers) was stubbed out in the release
+// build. WC_GAME_LOG=1 routes it to OSReport.
+extern "C" void EB_DebugPrintf_803ec320(CpuContext* ctx)
+{
+    static const bool enabled = std::getenv("WC_GAME_LOG") != nullptr;
+    if (enabled) {
+        OS__Report_801a25d0(ctx);
+    }
+}
+PPC_NATIVE_OVERRIDE_VOID(8E3EC320, EB_DebugPrintf_803ec320, (CpuContext* ctx), (ctx));
+
+// Boot waits for the Wii Remote library with a tight loop (0x803F127C):
+//   do { } while (WPADGetStatus() != WPAD_STATE_SETUP);
+// On hardware, alarms and IPC replies arrive as interrupts while it spins. Here they only run when
+// something services them, so service them on each poll, then read the real status
+// (WPADGetStatus 0x80067010 is a thunk to WUDGetStatus 0x800750B8).
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+extern "C" void EB_WPADGetStatus_80067010(CpuContext* ctx)
+{
+    OS_HLE_ProcessAlarms(8);
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+    InvokeIndirectCpu(0x800750B8u, ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8E067010, EB_WPADGetStatus_80067010, (CpuContext* ctx), (ctx));
+
+// AIStopDMA (0x800342c0). Mario Kart Wii never links it, so the runtime has no hook; on hardware it
+// clears the AI DMA enable bit (0xCC005036 bit 15), which the runtime does not map. The runtime's
+// audio output keeps running; the game restarts DMA with AIStartDMA when it wants sound again.
+extern "C" void EB_AIStopDMA_800342c0(CpuContext*) {}
+PPC_NATIVE_OVERRIDE_VOID(8E0342C0, EB_AIStopDMA_800342c0, (CpuContext* ctx), (ctx));
+
+// OSGetFontEncode (0x800570D4). The first call picks a default from the VI DTV status register
+// (0xCC00206E) on NTSC consoles, which the runtime does not emulate. A USA console with no
+// Japanese font reports ANSI (0); the rest is the SDK's own logic.
+namespace {
+constexpr uint32_t kFontEncodeAddr = 0x805A0218u;  // u16, -0x7dc8(r13); 0xFFFF until first use
+constexpr uint32_t kFontParseFnAddr = 0x805A1EE8u; // -0x60f8(r13)
+constexpr uint32_t kParseStringAnsi = 0x800575D0u;
+} // namespace
+
+extern "C" void EB_OSGetFontEncode_800570d4(CpuContext* ctx)
+{
+    uint16_t encode = Memory::Read16(kFontEncodeAddr);
+    if (encode == 0xFFFFu) {
+        encode = 0;
+        Memory::Write16(kFontEncodeAddr, encode);
+        Memory::Write32(kFontParseFnAddr, kParseStringAnsi);
+    }
+    ctx->gpr[3] = encode;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E0570D4, EB_OSGetFontEncode_800570d4, (CpuContext* ctx), (ctx));
+
+// __OSReadROM (0x8005A708): the system fonts from the IPL ROM, served from the bundled
+// replacement fonts by the Excite Truck hook (et_hooks.cpp), which is game-independent.
+extern "C" void ET_OSReadROM_80052f8c(CpuContext* ctx);
+
+extern "C" void EB_OSReadROM_8005a708(CpuContext* ctx)
+{
+    ET_OSReadROM_80052f8c(ctx);
+}
+PPC_NATIVE_OVERRIDE_VOID(8E05A708, EB_OSReadROM_8005a708, (CpuContext* ctx), (ctx));
+
+// NANDCreateAsync (0x800AF158) and NANDCreateDirAsync (0x800AF900): the public async calls, which
+// Mario Kart never links. Same arguments as the private ones the runtime implements.
+extern "C" int32_t NANDPrivateCreateAsync_HLE(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                              uint32_t commandBlockPtr);
+extern "C" int32_t NANDPrivateCreateDirAsync_HLE(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                                 uint32_t commandBlockPtr);
+
+extern "C" int32_t EB_NANDCreateAsync_800af158(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                               uint32_t commandBlockPtr)
+{
+    return NANDPrivateCreateAsync_HLE(pathPtr, perm, attr, callbackPtr, commandBlockPtr);
+}
+PPC_NATIVE_OVERRIDE(8E0AF158, EB_NANDCreateAsync_800af158, int32_t,
+    (uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr, uint32_t commandBlockPtr),
+    (pathPtr, perm, attr, callbackPtr, commandBlockPtr));
+
+extern "C" int32_t EB_NANDCreateDirAsync_800af900(uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr,
+                                                  uint32_t commandBlockPtr)
+{
+    return NANDPrivateCreateDirAsync_HLE(pathPtr, perm, attr, callbackPtr, commandBlockPtr);
+}
+PPC_NATIVE_OVERRIDE(8E0AF900, EB_NANDCreateDirAsync_800af900, int32_t,
+    (uint32_t pathPtr, uint32_t perm, uint32_t attr, uint32_t callbackPtr, uint32_t commandBlockPtr),
+    (pathPtr, perm, attr, callbackPtr, commandBlockPtr));
+
+// The Wii Remote / Wii Wheel choice (controller.lyt). 0x80326930 runs it for a new profile and
+// 0x80326A80 from Options; each returns 1 once a choice is made (the screen's result -2) and 0
+// when the player backs out, which shows the previous screen again. A pad plays the same either
+// way, so answer "chosen" without showing the screen: the profile keeps its default, the Wii
+// Remote.
+extern "C" void EB_ControllerTypeScreen_80326930(CpuContext* ctx)
+{
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E326930, EB_ControllerTypeScreen_80326930, (CpuContext* ctx), (ctx));
+
+extern "C" void EB_ControllerTypeOptions_80326a80(CpuContext* ctx)
+{
+    ctx->gpr[3] = 1;
+}
+PPC_NATIVE_OVERRIDE_VOID(8E326A80, EB_ControllerTypeOptions_80326a80, (CpuContext* ctx), (ctx));
diff --git a/runtime/src/hle/excitebots/eb_input.cpp b/runtime/src/hle/excitebots/eb_input.cpp
new file mode 100644
index 0000000..26bb627
--- /dev/null
+++ b/runtime/src/hle/excitebots/eb_input.cpp
@@ -0,0 +1,968 @@
+#include <utility>
+#include <string>
+// Excitebots (RX3E01): a virtual sideways Wii Remote driven by an Xbox-style gamepad or the
+// keyboard, answered at the KPAD level like Excite Truck (see et_input.cpp).
+//   - KPADSetConnectCallback (0x8004E984) is recorded; the first KPADRead reports channel 0 as
+//     connected through it, which is how the game's input layer (0x803F10E0) marks a remote.
+//   - KPADReadEx (0x8004DABC; KPADRead 0x8004DAB0 jumps to it) fills one KPADStatus.
+//   - WPADProbe (0x8006830C) reports a core remote on channel 0.
+// The game reads one KPADStatus per channel per frame (0x803F1C54) into 0x8059BAB8 + chan*0xCB0.
+//
+// Layout in a race: RT/RB gas (2), X and LT/LB brake (1), A turbo (D-pad), B the Wii A button
+// (weapons), left stick steers and tilts in the air (inverted by default), Y or View also the Wii
+// A button ("Press A to reset"), Start pauses (+). While the game shows a remote-motion prompt
+// (SHAKE!!! after a crash, Push on a bar) A plays a remote swing instead of only turbo.
+// Menus and the pause menu: A OK (2), B/X back (1), left stick or D-pad move, View is minus.
+// Keyboard: X/Enter gas, Z/Backspace brake, C or Space turbo and swing, arrows steer, W/S tilt,
+// A = Wii A, P pause.
+//
+// Addresses use the 0x8E000000 alias (see eb_hooks.cpp).
+
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_keyboard.h>
+
+#include <algorithm>
+#include <chrono>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "abi_bridge.h"
+#include "hle_stubs.h"
+#include "ppc_runtime.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+#include "input_bindings.h"
+
+bool EbShakePromptShown(); // gx_texture.cpp: the shaking remote (crash, bar spin, dentures)
+bool EbPushPromptShown();  // gx_texture.cpp: the pushed remote (let go of a bar)
+bool EbRedBarShown();      // gx_texture.cpp: a red (horizontal) bar's meter
+bool EbBarPromptShowsA();  // below: bars are played with A
+namespace EtPrompts {
+bool Active(); // et_prompts.cpp: the Xbox prompt pack is loaded
+}
+bool EbCrashMeterShown();  // gx_texture.cpp: the crash recovery meter
+bool EbMenuButtonsShown(); // gx_texture.cpp: a menu's Back / OK icons are on screen
+int EbControllerTypeScreenFrames(); // gx_texture.cpp: the Wii Remote / Wii Wheel choice, -1 if not shown
+
+namespace {
+
+constexpr uint32_t kWpadLeft = 0x0001;
+constexpr uint32_t kWpadRight = 0x0002;
+constexpr uint32_t kWpadDown = 0x0004;
+constexpr uint32_t kWpadUp = 0x0008;
+constexpr uint32_t kWpadPlus = 0x0010;
+constexpr uint32_t kWpad2 = 0x0100;
+constexpr uint32_t kWpad1 = 0x0200;
+constexpr uint32_t kWpadB = 0x0400;
+constexpr uint32_t kWpadA = 0x0800;
+constexpr uint32_t kWpadMinus = 0x1000;
+constexpr uint32_t kWpadHome = 0x8000;
+
+// Held sideways (D-pad on the left).
+constexpr uint32_t kSidewaysUp = kWpadRight;
+constexpr uint32_t kSidewaysDown = kWpadLeft;
+constexpr uint32_t kSidewaysLeft = kWpadUp;
+constexpr uint32_t kSidewaysRight = kWpadDown;
+
+constexpr uint32_t kKpadStatusSize = 0x84; // 2008 KPADStatus
+constexpr int kChannels = 4;
+constexpr int kEmulatedChannel = 0;
+
+constexpr float kMaxSteerAccZ = 0.5f;
+constexpr float kMaxPitchRadians = 0.785398f;
+constexpr float kStickDeadzone = 0.15f;
+
+std::array<uint32_t, kChannels> g_connectCallbacks{};
+bool g_connectReported = false;
+uint32_t g_previousHold = 0;
+SDL_Gamepad* g_gamepad = nullptr;
+
+SDL_Gamepad* ActiveGamepad()
+{
+    if (g_gamepad != nullptr && SDL_GamepadConnected(g_gamepad)) {
+        return g_gamepad;
+    }
+    g_gamepad = nullptr;
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    if (ids != nullptr) {
+        if (count > 0) {
+            g_gamepad = SDL_OpenGamepad(ids[0]);
+        }
+        SDL_free(ids);
+    }
+    return g_gamepad;
+}
+
+float StickAxis(SDL_Gamepad* pad, SDL_GamepadAxis axis)
+{
+    const float v = static_cast<float>(SDL_GetGamepadAxis(pad, axis)) / 32767.0f;
+    if (std::fabs(v) < kStickDeadzone) {
+        return 0.0f;
+    }
+    const float sign = v < 0.0f ? -1.0f : 1.0f;
+    return sign * std::min(1.0f, (std::fabs(v) - kStickDeadzone) / (1.0f - kStickDeadzone));
+}
+
+struct RemoteInput {
+    uint32_t hold = 0;
+    float steer = 0.0f; // -1 left .. +1 right
+    float pitch = 0.0f; // -1 nose down .. +1 nose up
+    int swing = -1; // which read of a swing this is, or -1
+    int thrust = 0; // on a red bar: thrust the remote forward (1) or back (-1)
+};
+
+uint32_t StickAsDpad(SDL_Gamepad* pad)
+{
+    static uint32_t held = 0;
+    const float x = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTX)) / 32767.0f;
+    const float y = static_cast<float>(SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTY)) / 32767.0f;
+    auto axis = [](float v, bool wasNeg, bool wasPos, bool& neg, bool& pos) {
+        const float on = 0.5f, off = 0.35f;
+        neg = v < -(wasNeg ? off : on);
+        pos = v > (wasPos ? off : on);
+    };
+    bool left, right, up, down;
+    axis(x, held & kSidewaysLeft, held & kSidewaysRight, left, right);
+    axis(y, held & kSidewaysUp, held & kSidewaysDown, up, down);
+    held = (left ? kSidewaysLeft : 0) | (right ? kSidewaysRight : 0) | (up ? kSidewaysUp : 0) |
+           (down ? kSidewaysDown : 0);
+    return held;
+}
+
+// Race state, found by watching the small-data area in menus, races and the pause menu:
+//   0x805A2CE4 (r13-0x52FC, float): the race simulation's time step. Zero in the menus, non-zero
+//                                   from the start of a race (it keeps its value while paused).
+//   0x805A2AC4 (r13-0x551C, float): the race clock in seconds. It stops while paused.
+// As for Excite Truck, a race counts as running while the step is set and the clock has moved in
+// the last 1.5 s, so the menus and the pause menu get the menu layout.
+constexpr uint32_t kRaceTimeStep = 0x805A2CE4u;
+constexpr uint32_t kRaceClock = 0x805A2AC4u;
+// The bar hint's A button this frame: 0 big, 1 smaller, 2 smallest (pressed), 3 smaller, 4 big
+// and pressed.
+int g_hintSize = 0;
+// Presses of A a second on a red bar, over the last kMashWindow seconds of race time.
+constexpr float kMashWindow = 0.75f;
+void WriteF32(uint32_t addr, float v);
+float ReadF32(uint32_t addr);
+// The local player's red bar helper (see the red bar in ReadInput), or 0. Every bot has one
+// (vtable 0x804D27B0), at an offset in the bot that depends on its kind (+0x1FD4, +0x2C94, ...),
+// holding the bot's address in its first 0x200 bytes. The local bot is found through its
+// controller: the controller (pointer at 0x805785D0) is held at +4 of a wrapper (vtable
+// 0x804D09C8), and a slot holding the wrapper's address follows one holding the bot's. Round
+// 21: the bot used to be taken from 0x805785F4, which holds it only in some events, so the red
+// bar boost worked on some courses and not others. Searching RAM takes a moment, so it is done
+// at most once a second, and the answer is kept while it still checks out.
+uint32_t HumanRedBarHelper()
+{
+    static uint32_t helper = 0, helperCtrl = 0;
+    static auto lastSearch = std::chrono::steady_clock::time_point{};
+    const uint32_t ctrl = Memory::Read32(0x805785D0u);
+    if (helper != 0 && ctrl == helperCtrl && Memory::Read32(helper) == 0x804D27B0u) return helper;
+    helper = 0;
+    const auto now = std::chrono::steady_clock::now();
+    if (ctrl == 0 || now - lastSearch < std::chrono::seconds(1)) return 0;
+    lastSearch = now;
+    const auto* ram = static_cast<const uint8_t*>(Memory::GetPointer(0x80000000u, 0x1800000u));
+    if (!ram) return 0;
+    auto be = [&](uint32_t off) { return uint32_t(ram[off]) << 24 | uint32_t(ram[off + 1]) << 16 | uint32_t(ram[off + 2]) << 8 | ram[off + 3]; };
+    constexpr uint32_t kSize = 0x1800000u;
+    uint32_t wrappers[4];
+    int wrapperCount = 0;
+    uint32_t helpers[16];
+    int helperCount = 0;
+    for (uint32_t o = 0; o + 8 <= kSize; o += 4) {
+        const uint32_t v = be(o);
+        if (v == 0x804D09C8u && be(o + 4) == ctrl && wrapperCount < 4) wrappers[wrapperCount++] = 0x80000000u + o;
+        if (v == 0x804D27B0u && helperCount < 16) helpers[helperCount++] = 0x80000000u + o;
+    }
+    if (wrapperCount == 0 || helperCount == 0) return 0;
+    for (uint32_t r = 4; r + 4 <= kSize; r += 4) {
+        const uint32_t v = be(r);
+        bool isWrapper = false;
+        for (int i = 0; i < wrapperCount; ++i) isWrapper = isWrapper || v == wrappers[i];
+        if (!isWrapper) continue;
+        const uint32_t bot = be(r - 4);
+        if (bot < 0x80000000u || bot >= 0x81800000u) continue;
+        for (int i = 0; i < helperCount; ++i) {
+            const uint32_t h = helpers[i] - 0x80000000u;
+            for (uint32_t k = 4; k < 0x200 && h + k + 4 <= kSize; k += 4) {
+                if (be(h + k) != bot) continue;
+                helper = helpers[i];
+                helperCtrl = ctrl;
+                return helper;
+            }
+        }
+    }
+    return 0;
+}
+// On a red bar: its meter is drawn (the contests' art; a race may draw other art), or the local
+// player's red bar helper is swinging (state 4 at +8; 1 is free, 2 near a bar).
+bool OnRedBar()
+{
+    if (EbRedBarShown()) return true;
+    if (!EbPushPromptShown()) return false; // a bar shows the Push prompt; spares the RAM search
+    const uint32_t helper = HumanRedBarHelper();
+    return helper != 0 && Memory::Read32(helper + 8) == 4u;
+}
+uint32_t g_redBarHelper = 0;
+float g_redBarBaseAccel = 1.0f;
+const float kRedBarAccelSlow = 1.0f;
+const float kRedShakeEvery = std::getenv("WC_EB_SHAKE_EVERY") ? float(std::atof(std::getenv("WC_EB_SHAKE_EVERY"))) : 0.25f;
+const float kRedShakeLength = std::getenv("WC_EB_SHAKE_LEN") ? float(std::atof(std::getenv("WC_EB_SHAKE_LEN"))) : 0.12f;
+const int kRedShakeStrength = std::getenv("WC_EB_THRUST_MAG") ? std::atoi(std::getenv("WC_EB_THRUST_MAG")) : 2;
+const float kRedShakeEveryFast = 0.12f;
+const float kRedShakeLengthFast = 0.08f;
+const float kRedBarFullRate = 3.0f; // presses a second for full speed
+const float kRedBarAccelFast = std::getenv("WC_EB_ACCEL_MAX") ? float(std::atof(std::getenv("WC_EB_ACCEL_MAX"))) : 6.8f;
+void EbRestoreRedBarAccel()
+{
+    if (g_redBarHelper != 0 && Memory::Read32(g_redBarHelper) == 0x804D27B0u) WriteF32(g_redBarHelper + 12, g_redBarBaseAccel);
+    g_redBarHelper = 0;
+}
+// The red bar hint bounce (0 at rest, 1 at the bottom): crash recovery's bounce (two every 0.55 s),
+// played twice as fast (Chris, round 15).
+const float kRedHintBounceTime = std::getenv("WC_EB_HINT_BOUNCE") ? float(std::atof(std::getenv("WC_EB_HINT_BOUNCE"))) : 0.14f;
+float RedHintBounce(float clock)
+{
+    return std::fabs(std::sin(clock * (3.14159265f / kRedHintBounceTime)));
+}
+const float kRedHintDrop = std::getenv("WC_EB_HINT_DROP") ? float(std::atof(std::getenv("WC_EB_HINT_DROP"))) : 17.0f;
+float g_mashRate = 0.0f;
+
+void WriteF32(uint32_t addr, float v);
+float ReadF32(uint32_t addr)
+{
+    const uint32_t bits = Memory::Read32(addr);
+    float v;
+    std::memcpy(&v, &bits, sizeof(v));
+    return v;
+}
+
+bool RaceRunning()
+{
+    if (!(ReadF32(kRaceTimeStep) > 0.0f)) {
+        return false;
+    }
+    static float lastClock = -1.0f;
+    static auto lastChange = std::chrono::steady_clock::now();
+    const float clock = ReadF32(kRaceClock);
+    const auto now = std::chrono::steady_clock::now();
+    if (clock != lastClock) {
+        lastClock = clock;
+        lastChange = now;
+    }
+    return now - lastChange < std::chrono::milliseconds(1500);
+}
+
+// Swings. Excitebots reads remote motion through its own detector (0x801E3D50): it keeps a slow
+// average of the gravity vector and reports a "flick" when the measured acceleration points
+// against that average, and a "shake" strength from how fast it changes. Crash recovery
+// ("SHAKE!!!") and letting go of a bar ("Push") are driven by these; grabbing a bar is
+// automatic. A virtual remote never moves, so each press of the swing button plays a short swing
+// instead: a few reads with the acceleration thrown hard against gravity, then back to rest.
+constexpr int kSwingReads = 3;
+int g_swingReadsLeft = 0;
+
+RemoteInput ReadInput()
+{
+    RemoteInput in;
+    // A menu over a race (pause, Training's lesson cards, results) takes the menu layout.
+    const bool racing = RaceRunning() && !EbMenuButtonsShown();
+    static int lastRacing = -1;
+    if (int(racing) != lastRacing && std::getenv("WC_TRACE_INPUT")) {
+        RT_LOGF(RT_TAG_HLE, "EB layout %s (step %.4f clock %.3f)\n", racing ? "race" : "menu",
+                ReadF32(kRaceTimeStep), ReadF32(kRaceClock));
+    }
+    lastRacing = racing;
+    const bool invertAir = RuntimeConfigFile::InvertAirControl(true);
+    bool swingButton = false;
+    bool actionButton = false; // A on the pad, C or Space: turbo, or the motion a prompt asks for
+    float stickX = 0.0f, stickY = 0.0f; // the left stick in a race, for the motion prompts
+    // The exit prompt or the F10 bar has the controls.
+    if (InputBindings::InputBlocked()) {
+        return in;
+    }
+    if (SDL_Gamepad* pad = ActiveGamepad()) {
+        auto button = [pad](SDL_GamepadButton b) { return SDL_GetGamepadButton(pad, b); };
+        const bool rightTrigger = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > 8000;
+        const bool leftTrigger = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > 8000;
+        // Y is always the Wii A button ("Press A to reset"). B is too in a race (weapons), and
+        // back (1) in the menus.
+        if (button(SDL_GAMEPAD_BUTTON_NORTH)) in.hold |= kWpadA;
+        if (button(SDL_GAMEPAD_BUTTON_WEST)) in.hold |= kWpad1;
+        if (button(SDL_GAMEPAD_BUTTON_EAST)) in.hold |= racing ? kWpadA : kWpad1;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_UP)) in.hold |= kSidewaysUp;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_DOWN)) in.hold |= kSidewaysDown;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_LEFT)) in.hold |= kSidewaysLeft;
+        if (button(SDL_GAMEPAD_BUTTON_DPAD_RIGHT)) in.hold |= kSidewaysRight;
+        if (button(SDL_GAMEPAD_BUTTON_START)) in.hold |= kWpadPlus;
+        // Guide opens the runtime's exit prompt (settings_overlay.cpp), not the Wii HOME menu.
+        if (racing) {
+            // Drive: RT/RB gas (2), X and LT/LB brake (1), A turbo (any D-pad direction), B the Wii
+            // A button (weapons), left stick steers and tilts in the air. While the game asks for a
+            // remote motion (SHAKE!!! after a crash, Push on a bar) A plays a swing instead.
+            if (rightTrigger || button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER)) in.hold |= kWpad2;
+            if (leftTrigger || button(SDL_GAMEPAD_BUTTON_LEFT_SHOULDER)) in.hold |= kWpad1;
+            if (button(SDL_GAMEPAD_BUTTON_SOUTH)) {
+                in.hold |= kSidewaysUp;
+                actionButton = true;
+            }
+            if (button(SDL_GAMEPAD_BUTTON_BACK)) in.hold |= kWpadA;
+            in.steer = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+            stickX = in.steer;
+            stickY = StickAxis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+            in.pitch = invertAir ? stickY : -stickY;
+        } else {
+            // Menus: A is OK (2), B/X back (1), the stick moves the cursor and the remote stays
+            // level. RT/R also confirm.
+            if (button(SDL_GAMEPAD_BUTTON_SOUTH) || rightTrigger || button(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER)) {
+                in.hold |= kWpad2;
+            }
+            if (button(SDL_GAMEPAD_BUTTON_BACK)) in.hold |= kWpadMinus;
+            in.hold |= StickAsDpad(pad);
+        }
+    }
+    int keyCount = 0;
+    const bool* keys = SDL_GetKeyboardState(&keyCount);
+    if (keys != nullptr) {
+        auto key = [keys, keyCount](SDL_Scancode sc) { return static_cast<int>(sc) < keyCount && keys[sc]; };
+        if (key(SDL_SCANCODE_X) || key(SDL_SCANCODE_RETURN)) in.hold |= kWpad2;
+        if (key(SDL_SCANCODE_Z) || key(SDL_SCANCODE_BACKSPACE)) in.hold |= kWpad1;
+        if (key(SDL_SCANCODE_C) || key(SDL_SCANCODE_SPACE)) {
+            in.hold |= kSidewaysUp;
+            if (racing) actionButton = true;
+        }
+        if (key(SDL_SCANCODE_P)) in.hold |= kWpadPlus;
+        if (key(SDL_SCANCODE_A)) in.hold |= kWpadA;
+        if (key(SDL_SCANCODE_B)) in.hold |= kWpadB;
+        const bool gasHeld = (in.hold & kWpad2) != 0;
+        if (key(SDL_SCANCODE_LEFT)) { if (!racing || !gasHeld) in.hold |= kSidewaysLeft; in.steer = -1.0f; }
+        if (key(SDL_SCANCODE_RIGHT)) { if (!racing || !gasHeld) in.hold |= kSidewaysRight; in.steer = 1.0f; }
+        if (key(SDL_SCANCODE_UP)) in.hold |= kSidewaysUp;
+        if (key(SDL_SCANCODE_DOWN)) in.hold |= kSidewaysDown;
+        if (key(SDL_SCANCODE_W)) in.pitch = invertAir ? -1.0f : 1.0f;
+        if (key(SDL_SCANCODE_S)) in.pitch = invertAir ? 1.0f : -1.0f;
+    }
+    // The Wii Remote / Wii Wheel choice (new profile, Options) means nothing on a pad: both play
+    // the same. Once it has settled on screen, confirm the highlighted Wii Remote for the player.
+    // Tapped every few frames from the first one, since the menu ignores input while it fades in.
+    if (const int frames = EbControllerTypeScreenFrames(); !racing && frames >= 0) {
+        if (frames % 6 < 3) in.hold |= kWpad2;
+    }
+    if (!racing) {
+        in.steer = 0.0f; // keep the remote level in the menus
+        in.pitch = 0.0f;
+    }
+    // The motion prompts, played with the left stick (the prompt pack draws a stick there).
+    // Push (let go of a bar): flick the stick, one swing per flick. The crash recovery's shake:
+    // shake the stick, one swing per change of side. The shake on a bar spin or in the dentures:
+    // the stick pushed any way rocks the remote at full speed. A still works: a swing per press,
+    // or held, a rocking remote.
+    if (racing) {
+        const bool shake = EbShakePromptShown();
+        const bool push = EbPushPromptShown();
+        const bool crashShake = shake && EbCrashMeterShown();
+        static bool flicked = false;
+        static int lastSide = 0;
+        const float mag = std::sqrt(stickX * stickX + stickY * stickY);
+        // Push (swinging on a bar): every stroke of the stick plays a swing, forward or back, or
+        // any other way. A stroke is the stick reaching a new direction (past 50%): forward, then
+        // back, then forward again is three swings, even when it never stops in the middle (a fast
+        // forward-back flip skips the centre between two reads, so waiting for the centre missed
+        // most of them). The stick held in one direction, or A held, swings again every 12 reads.
+        static bool pushWasShown = false;
+        static int heldReads = 0;
+        static int lastDir = 0; // 1 forward, 2 back, 3 left, 4 right
+        // Bars are played with A (Chris, round 12): on a red (horizontal, swinging) bar every
+        // tap of A adds momentum, so tapping faster swings harder; on a yellow (vertical) bar one
+        // press of A, timed by the player, lets go. The hint is an A button that stays still and
+        // grows and shrinks (BarPromptSprite): quickly on a red bar, slower on a yellow one.
+        // WC_EB_AUTO_BARS=1 plays bars without A (round 10); WC_EB_MANUAL_BARS=1 goes back to
+        // stick strokes and A swings (round 8).
+        static const bool manualBars = std::getenv("WC_EB_MANUAL_BARS") != nullptr;
+        static const bool autoBars = !manualBars;
+        static const bool playAlone = std::getenv("WC_EB_AUTO_BARS") != nullptr;
+        static bool barActionWasDown = false;
+        const float clock = ReadF32(kRaceClock);
+        // Developer aid: WC_EB_TEST_TAP=S taps A every S seconds of race time on a red bar, and
+        // once, S seconds after it is grabbed, on a yellow one.
+        static const float testTap = std::getenv("WC_EB_TEST_TAP") ? float(std::atof(std::getenv("WC_EB_TEST_TAP"))) : 0.0f;
+        static float barStart = 0.0f;
+        if (push && !pushWasShown) barStart = clock;
+        bool tapDown = actionButton;
+        if (testTap > 0.0f && push) {
+            const float t = clock - barStart;
+            tapDown = OnRedBar() ? (std::fmod(t, testTap) < testTap * 0.5f) : (t >= testTap && t < testTap + 0.1f);
+        }
+        // What spins the bot round a bar is rocking the remote forward and back (its pitch); on a
+        // red bar its meter fills from thrusts of the remote along its length, forward then back
+        // (the hint's side-on remote); a thrust lets go of a yellow bar.
+        static const float pumpHalf = std::getenv("WC_EB_PUMP_HALF") ? float(std::atof(std::getenv("WC_EB_PUMP_HALF"))) : 0.25f;
+        static int thrustReads = 0;
+        static float thrustEnd = 0.0f;
+        static int thrustDir = 1;
+        static float pitchDir = 1.0f;
+        if (!(push && OnRedBar())) EbRestoreRedBarAccel();
+        if (autoBars && push) {
+            const bool red = OnRedBar();
+            const bool tap = tapDown && !barActionWasDown;
+            if (!pushWasShown) { thrustReads = 0; thrustEnd = 0.0f; pitchDir = 1.0f; }
+            if (playAlone) {
+                if (red) {
+                    static int lastSlot = -1;
+                    const int slot = int(clock / 0.5f);
+                    if (slot != lastSlot) { lastSlot = slot; thrustReads = 3; thrustEnd = clock + 0.08f; thrustDir = (slot % 2) ? -1 : 1; }
+                }
+                pitchDir = (int(clock / pumpHalf) % 2) ? 1.0f : -1.0f;
+            } else if (red) {
+                static float taps[16];
+                static int tapCount = 0;
+                static float lastThrust = -10.0f;
+                if (!pushWasShown) { tapCount = 0; lastThrust = -10.0f; }
+                if (tap) {
+                    if (tapCount == 16) { std::memmove(taps, taps + 1, 15 * sizeof(float)); tapCount = 15; }
+                    taps[tapCount++] = clock;
+                }
+                int recent = 0;
+                for (int i = 0; i < tapCount; ++i) recent += (clock - taps[i] <= kMashWindow && clock >= taps[i]) ? 1 : 0;
+                g_mashRate = float(recent) / kMashWindow;
+                // How a red bar paces itself: the game builds the swing up while the remote is
+                // shaken back and forth in time with it, and each turn waits partway round for
+                // a shake to carry it on (up to about a second), so the more shakes the sooner
+                // each turn comes round, up to the bar's own limit. The remote shakes as often
+                // as A is being pressed (over the last 0.75 s), up to 8 times a second, and
+                // stops when A does; the first press shakes at once. So, as in crash recovery:
+                // mash faster, swing faster.
+                // The bar's own pace: the player's red bar helper (vtable 0x804D27B0; see
+                // HumanRedBarHelper) keeps "red_bar_accel" at +12, 1.0 for
+                // the player, which sets how hard each shake speeds the spin. Shakes alone are
+                // capped by it, so frantic mashing barely beat steady pressing (Chris, round 15).
+                // Scale it with the mash rate: as is at one press a second, 6.8 times at three
+                // or more (round 17: 10x works on Chris's PC, "almost too fast"; round 18's 8x
+                // seemed to fall back to the slow swing, but that was the bot lookup failing on
+                // some courses (fixed in round 21); round 22 8x, round 23 15% less; 4x took
+                // School_Mexico's bar from 7.6 s to 4.6 s here). Put back when the bar ends
+                // (EbRestoreRedBarAccel).
+                if (const uint32_t helper = HumanRedBarHelper()) {
+                    if (g_redBarHelper != helper) {
+                        EbRestoreRedBarAccel();
+                        g_redBarHelper = helper;
+                        g_redBarBaseAccel = ReadF32(helper + 12);
+                    }
+                    const float t = std::clamp((g_mashRate - 1.0f) / (kRedBarFullRate - 1.0f), 0.0f, 1.0f);
+                    WriteF32(helper + 12, g_redBarBaseAccel * (kRedBarAccelSlow + (kRedBarAccelFast - kRedBarAccelSlow) * t));
+                    static const bool traceTurns = std::getenv("WC_EB_TRACE_TURNS") != nullptr;
+                    if (traceTurns) // the turn count is +0xA0 of the bar state at +0x1FC4 in the player
+                        RT_LOGF(RT_TAG_HLE, "EB turns %.3f %.3f rate %.1f accel %.2f\n", clock, ReadF32(helper - 0x10 + 0xA0), g_mashRate, ReadF32(helper + 12));
+                }
+                if (recent > 0) {
+                    // While A is being mashed at all, the remote is shaken in the bar's best
+                    // rhythm, timed in race time so each shake spans the same game ticks at any
+                    // frame rate (round 14 timed them in reads: 3 ticks at 60 FPS, too short to
+                    // register, though 18 in a slow test). Any mashing shakes every 0.25 s for
+                    // 0.12 s; faster mashing shakes faster, up to every 0.12 s for 0.08 s at 3
+                    // presses a second, each shake twice as hard (School_Mexico's bar: 1 press a
+                    // second 6.1 s, 4 a second 3.6 s, with the accel below).
+                    if (tap && clock - lastThrust > 0.75f) lastThrust = -10.0f;
+                    const float pace = std::clamp((g_mashRate - 1.0f) / (kRedBarFullRate - 1.0f), 0.0f, 1.0f);
+                    if (clock - lastThrust >= kRedShakeEvery + (kRedShakeEveryFast - kRedShakeEvery) * pace || clock < lastThrust) {
+                        lastThrust = clock;
+                        thrustReads = 3;
+                        thrustEnd = clock + kRedShakeLength + (kRedShakeLengthFast - kRedShakeLength) * pace;
+                        thrustDir = -thrustDir;
+                        pitchDir = -pitchDir;
+                    }
+                }
+            } else if (tap) {
+                // A yellow bar: one press is a forward thrust, which lets go. A thrust lasts at
+                // least 3 reads and 0.08 s of race time, so it reads as one at any frame rate.
+                thrustReads = 3;
+                thrustEnd = clock + 0.08f;
+                thrustDir = 1;
+            }
+            if (thrustReads > 0 || clock < thrustEnd) {
+                --thrustReads;
+                in.thrust = thrustDir * ((red && !playAlone) ? kRedShakeStrength : 1);
+            }
+            in.pitch = (red || playAlone) ? pitchDir : 0.0f;
+            // A on a bar is for the bar; it is not a turbo or a remote swing there.
+            in.hold &= ~kSidewaysUp;
+            // The hint. On a red bar, crash recovery's A: up, then pressed, ten changes a second.
+            // On a yellow bar an A shrinking and growing again in four steps, twice a second.
+            if (red) {
+                g_hintSize = RedHintBounce(clock) > 0.6f ? 4 : 0;
+            } else {
+                g_hintSize = int(std::fmod(clock, 0.5f) / 0.5f * 4.0f) & 3;
+            }
+        }
+        actionButton = tapDown;
+        barActionWasDown = actionButton;
+        if (push && !autoBars) {
+            static const bool testStroke = std::getenv("WC_EB_TEST_STICK") != nullptr;
+            if (testStroke) {
+                static int t = 0;
+                stickX = 0.0f;
+                stickY = ((++t / 8) % 2) ? -1.0f : 1.0f;
+            }
+            const float mag = std::sqrt(stickX * stickX + stickY * stickY);
+            int dir = 0;
+            if (mag > 0.5f) {
+                if (std::fabs(stickY) >= std::fabs(stickX)) dir = stickY < 0.0f ? 1 : 2;
+                else dir = stickX < 0.0f ? 3 : 4;
+            }
