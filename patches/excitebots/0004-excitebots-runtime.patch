+// Which size of the bar hint's A to draw this frame (gx_texture.cpp picks its texture).
+int EbBarHintSize() { return g_hintSize; }
+
+// The bar prompt shows a pulsing A button unless bars are played with the stick (round 8).
+bool EbBarPromptShowsA() {
+    static const bool manualBars = std::getenv("WC_EB_MANUAL_BARS") != nullptr;
+    if (manualBars) return false;
+    // The A is drawn by the prompt pack; without it the Wii Remote picture stays as it is.
+    static int checked = 0;
+    static bool active = false;
+    if ((checked++ & 63) == 0) active = EtPrompts::Active();
+    return active;
+}
