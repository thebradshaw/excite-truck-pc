+// Excitebots: notices when the game draws one of its "move the remote" prompts (the crash
+// "SHAKE!!!" remote and the bar "Push" remote, both 256x256 CMPR). The pad's A button only plays a
+// remote swing while one of them is on screen, so at other times A is turbo alone. Textures are
+// identified by the same XXH64 of the base level that names the replacement files; each address
+// is hashed once and checked again only when its first bytes change.
+// Excitebots screens recognised by a texture they draw (XXH64 of the CMPR base level, the hash
+// in the texture dump names): the swing prompts, during which the A button plays a remote swing,
+// the Wii Remote / Wii Wheel choice, which input skips, and the Back / OK button icons of any
+// menu, which switch the pad to the menu layout even mid-race (eb_input.cpp).
+bool EbBarPromptShowsA(); // eb_input.cpp: bars are played with A (the default)
+int EbBarHintSize();      // eb_input.cpp: which of the bar hint's A pictures to draw (0-4)
+void EbNoteBarPromptTexture(); // eb_input.cpp: the sprite being drawn is the bar prompt
+namespace EbScreenTextures {
+enum Kind : uint8_t { kNone, kShake, kPush, kPushMask, kCrashMeter, kControllerType, kMenuButton, kRedBar };
+std::mutex g_mutex;
+struct Seen {
+    uint64_t head = 0;
+    Kind kind = kNone;
+};
+std::unordered_map<uint32_t, Seen> g_seen;
+std::atomic<int> g_lastShake{-1000};
+std::atomic<int> g_lastPush{-1000};
+std::atomic<int> g_lastCrashMeter{-1000};
+std::atomic<int> g_lastRedBar{-1000};
+std::atomic<int> g_lastControllerType{-1000};
+std::atomic<int> g_firstControllerType{0};
+std::atomic<int> g_lastMenuButton{-1000};
+
+Kind Classify(uint16_t w, uint16_t h, uint64_t hash) {
+    if (w == 256 && h == 256 && hash == 0xf2965209f9cff340ull) {  // overlays.res shakecont.art
+        return kShake;
+    }
+    if (w == 256 && h == 256 && hash == 0xddf1c663d39c4ad2ull) {  // the bar's "Push" remote
+        return kPush;
+    }
+    if (w == 256 && h == 256 && hash == 0xaa8407612f74e6baull) {  // its I4 mask
+        return kPushMask;
+    }
+    if (w == 256 && h == 256 && hash == 0xfcf8a1191fd23f9cull) {  // the crash meter's chevrons
+        return kCrashMeter;
+    }
+    if (w == 256 && h == 256 && hash == 0x78583d305e906e63ull) {  // drawn only on a red bar
+        return kRedBar;
+    }
+    if (w == 256 && h == 128 && hash == 0xc8c6e66dee7d90ccull) {  // the remote and wheel pictures
+        return kControllerType;
+    }
+    if (w == 64 && h == 64 &&
+        (hash == 0xc8e9868a2a851ed2ull ||     // common.res but_1 ("Back")
+         hash == 0x82d8d8bfb09e0473ull)) {    // common.res but_2 ("OK", "Select")
+        return kMenuButton;
+    }
+    return kNone;
+}
+
+Kind Note(uint32_t oa, uint32_t* dataAddr = nullptr) {
+    TexObjMeta m;
+    {
+        std::lock_guard<std::mutex> guard(g_texObjMutex);
+        try {
+            if (!TryGetOrExtractTexObjMeta(oa, m)) return kNone;
+        } catch (...) {
+            return kNone;
+        }
+    }
+    const bool large = m.width == 256 && (m.height == 256 || m.height == 128);
+    const bool icon = m.width == 64 && m.height == 64;
+    const bool i4Mask = m.width == 256 && m.height == 256 && m.format == GX_TF_I4;
+    if (!(large || icon) || (m.format != GX_TF_CMPR && !i4Mask) || m.dataAddr == 0) {
+        return kNone;
+    }
+    const uint32_t bytes = uint32_t(m.width) * m.height / 2u; // CMPR base level
+    if (!Memory::Contains(m.dataAddr, bytes)) return kNone;
+    const auto* data = static_cast<const uint8_t*>(GuestToHostPtr(m.dataAddr, bytes));
+    if (data == nullptr) return kNone;
+    uint64_t head;
+    std::memcpy(&head, data, sizeof(head));
+    Kind kind;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        Seen& seen = g_seen[m.dataAddr];
+        if (seen.head != head || head == 0) {
+            seen.head = head;
+            seen.kind = Classify(m.width, m.height, XXH64(data, bytes, 0));
+        }
+        kind = seen.kind;
+    }
+    if (kind == kMenuButton) g_lastMenuButton.store(g_gxFrameCount, std::memory_order_relaxed);
+    if (kind == kShake) {
+        if (std::getenv("WC_TRACE_INPUT") && g_gxFrameCount - g_lastShake.load(std::memory_order_relaxed) > 3) {
+            RT_LOGF(RT_TAG_GX, "Excitebots shake prompt shown\n");
+        }
+        g_lastShake.store(g_gxFrameCount, std::memory_order_relaxed);
+    }
+    if (kind == kPush) g_lastPush.store(g_gxFrameCount, std::memory_order_relaxed);
+    if (kind == kCrashMeter) g_lastCrashMeter.store(g_gxFrameCount, std::memory_order_relaxed);
+    if (kind == kRedBar) g_lastRedBar.store(g_gxFrameCount, std::memory_order_relaxed);
+    if (kind == kControllerType) {
+        const int now = g_gxFrameCount;
+        if (now - g_lastControllerType.load(std::memory_order_relaxed) > 3) {
+            g_firstControllerType.store(now, std::memory_order_relaxed);
+        }
+        g_lastControllerType.store(now, std::memory_order_relaxed);
+    }
+    if (dataAddr) *dataAddr = m.dataAddr;
+    return kind;
+}
+
+// A copy of a 256x256 CMPR prompt texture whose first 4x4 block (hidden by the prompt's mask)
+// carries an 8-byte mark, so it hashes differently and the prompt pack can draw something else
+// for it. One buffer per mark; a buffer is rebuilt when the source texture changes.
+const uint8_t* MarkedVariant(uint32_t dataAddr, int slot, const char (&mark)[9]) {
+    constexpr uint32_t kBytes = 256u * 256u / 2u;
+    struct Variant {
+        std::unique_ptr<uint8_t[]> data;
+        uint32_t addr = 0;
+        uint64_t head = 0;
+    };
+    static Variant variants[10];
+    Variant& v = variants[slot];
+    if (!Memory::Contains(dataAddr, kBytes)) return nullptr;
+    const auto* src = static_cast<const uint8_t*>(GuestToHostPtr(dataAddr, kBytes));
+    if (src == nullptr) return nullptr;
+    uint64_t head;
+    std::memcpy(&head, src + 8, sizeof(head));
+    if (!v.data || v.addr != dataAddr || v.head != head) {
+        v.data.reset(new uint8_t[kBytes]);
+        std::memcpy(v.data.get(), src, kBytes);
+        std::memcpy(v.data.get(), mark, 8);
+        v.addr = dataAddr;
+        v.head = head;
+        RT_LOGF(RT_TAG_GX, "Excitebots prompt variant %s %016llx\n", mark,
+                static_cast<unsigned long long>(XXH64(v.data.get(), kBytes, 0)));
+    }
+    return v.data.get();
+}
