+namespace {
+// Crash recovery shows "SHAKE!!!" over the meter, which reads as an instruction to shake the pad.
+// The text comes from the race's message table; once a race has loaded, find it in guest memory
+// (ASCII or UTF-16) and cut it to an empty string. A word must start right there and continue
+// with '!', which leaves keys such as "Popup:SHAKE" alone.
+void HideShakeText()
+{
+    struct Range { uint32_t begin, end; };
+    static const Range kRanges[] = {{0x80000000u, 0x81800000u}, {0x90000000u, 0x94000000u}};
+    int hidden = 0;
+    for (const Range& r : kRanges) {
+        const uint8_t* base = Memory::GetPointer(r.begin, r.end - r.begin);
+        if (base == nullptr) continue;
+        const size_t size = r.end - r.begin;
+        static const uint8_t kAscii[] = {'S', 'H', 'A', 'K', 'E', '!'};
+        static const uint8_t kWide[] = {0, 'S', 0, 'H', 0, 'A', 0, 'K', 0, 'E', 0, '!'};
+        for (size_t i = 1; i + sizeof(kWide) < size; ++i) {
+            if (base[i] != 'S' && base[i] != 0) continue;
+            if (std::memcmp(base + i, kAscii, sizeof(kAscii)) == 0 && !std::isalpha(base[i - 1])) {
+                Memory::Write8(r.begin + uint32_t(i), 0);
+                ++hidden;
+            } else if ((i % 2) == 0 && std::memcmp(base + i, kWide, sizeof(kWide)) == 0 &&
+                       !(base[i - 2] == 0 && std::isalpha(base[i - 1]))) {
+                Memory::Write8(r.begin + uint32_t(i) + 1, 0);
+                ++hidden;
+            }
+        }
+    }
+    if (std::getenv("WC_TRACE_INPUT")) RT_LOGF(RT_TAG_HLE, "EB hid %d SHAKE!!! text(s)\n", hidden);
+}
+} // namespace
+
+// The "how to" cards shown after a race's intro screen (0x800113C0 queues them when the event's
+// howto_guide is red_bar, yellow_bar, leg_run or glide) explain Wii Remote motions. Break the
+// four names it compares against so no card is queued.
+static void DisableHowToCards()
+{
+    static const std::pair<uint32_t, const char*> kGuides[] = {
+        {0x80477511u, "red_bar"}, {0x80477567u, "yellow_bar"}, {0x804775CCu, "leg_run"}, {0x80477623u, "glide"},
+    };
+    for (const auto& [addr, name] : kGuides) {
+        bool match = true;
+        for (size_t i = 0; name[i] != 0 && match; ++i) match = Memory::Read8(addr + i) == static_cast<uint8_t>(name[i]);
+        if (match) {
+            Memory::Write8(addr, '#');
+        } else {
+            std::fprintf(stderr, "[hle] EB how-to name %s not found at %08x\n", name, addr);
+        }
+    }
+}
+
+void EbFrameTick()
+{
+    constexpr uint32_t kBootStep = 0x805A47F0u;
+    constexpr uint32_t kBootDone = 11;
+    static bool done = false;
+    static bool saveChecked = false;
+    if (!saveChecked) {
+        saveChecked = true;
+        EbRepairBrokenSave();
+        DisableHowToCards();
+    }
+    // 60 FPS races. The engine simulates in 1/59.94 s ticks, but a race start (0x800096C0) asks the
+    // frame pacer (0x803D0C00) for one frame every 2 retraces, i.e. 30 FPS with two ticks a frame;
+    // the menus run at 1. Ask for 1 while a race is loaded: the game then draws every tick and its
+    // race clock still follows real time. WC_EB_30FPS=1 keeps the original rate.
+    constexpr uint32_t kFrameIntervalRequest = 0x805A1768u; // -0x6878(r13), 0x803D0800 sets it
+    static const bool keep30 = std::getenv("WC_EB_30FPS") != nullptr;
+    if (!keep30 && ReadF32(kRaceTimeStep) > 0.0f && Memory::Read32(kFrameIntervalRequest) == 2) {
+        Memory::Write32(kFrameIntervalRequest, 1);
+    }
+    // Once per race, as it starts (the text is loaded with the race): when the race step appears,
+    // or the race clock goes back (the next race).
+    static bool wasRacing = false;
+    static float lastClock = 0.0f;
+    const bool racing = ReadF32(kRaceTimeStep) > 0.0f;
+    const float clock = ReadF32(kRaceClock);
+    if (racing && (!wasRacing || clock + 1.0f < lastClock)) HideShakeText();
+    wasRacing = racing;
+    lastClock = clock;
+    if (done) {
+        return;
+    }
+    const uint32_t step = Memory::Read32(kBootStep);
+    if (step == kBootDone) {
+        done = true;
+    } else if (step < kBootDone) {
+        Memory::Write32(kBootStep, kBootDone);
+    }
+}
+
+// For the GX thread: true while a race is loaded (paused included). Reads memory only.
+bool EbRaceRunningForGx()
+{
+    return ReadF32(kRaceTimeStep) > 0.0f;
+}
