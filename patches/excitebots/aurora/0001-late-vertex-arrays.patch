+// Late-array window (aurora_set_late_array_window): a game may finish writing a vertex array
+// after it has queued the draw that reads it, because real hardware fetches vertices only when
+// the GPU gets to the draw. Arrays inside the window are copied once more at the end of the
+// frame, unless the same source was staged more than once this frame (then its contents may
+// legitimately differ between draws, so the draw-time copies stand).
+struct LateArray {
+  const uint8_t* src;
+  uint32_t size;
+  uint32_t offset;
+};
+std::atomic<const uint8_t*> g_lateArrayLo{nullptr};
+std::atomic<const uint8_t*> g_lateArrayHi{nullptr};
+std::vector<LateArray> g_lateArrays;
+
+static void note_late_array(const void* data, uint32_t size, gfx::Range range) noexcept {
+  const auto* src = static_cast<const uint8_t*>(data);
+  const auto* lo = g_lateArrayLo.load(std::memory_order_relaxed);
+  const auto* hi = g_lateArrayHi.load(std::memory_order_relaxed);
+  if (lo == nullptr || src < lo || src + size > hi || range.size < size) {
+    return;
+  }
+  g_lateArrays.push_back({src, size, range.offset});
+}
+
 static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Range vertRange, gfx::Range idxRange,
                          u32 numIndices) noexcept {
   auto& state = g_gxState;
@@ -496,6 +522,7 @@ static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Rang
     auto& array = state.arrays[i];
     if (array.cachedRange.size == 0) {
       array.cachedRange = gfx::push_storage(static_cast<const uint8_t*>(array.data), array.size);
+      note_late_array(array.data, array.size, array.cachedRange);
     }
     immediates.arrayStart[i - GX_VA_POS] = array.cachedRange.offset;
   }
@@ -633,6 +660,7 @@ static void push_gx_draw(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Rang
   });
 }
 
+
 static void handle_draw_unmerged(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, gfx::Range vertRange) noexcept {
   ZoneScoped;
   u32 numIndices = 0;
@@ -994,4 +1022,30 @@ void clear_draw_cache() noexcept {
   sDrawCache.hasFogRange = false;
 }
 
+void refresh_late_arrays(uint8_t* storage, size_t storageSize) noexcept {
+  if (g_lateArrays.empty()) {
+    return;
+  }
+  std::sort(g_lateArrays.begin(), g_lateArrays.end(), [](const LateArray& a, const LateArray& b) {
+    return a.src != b.src ? a.src < b.src : a.size < b.size;
+  });
+  for (size_t i = 0; i < g_lateArrays.size();) {
+    size_t j = i + 1;
+    while (j < g_lateArrays.size() && g_lateArrays[j].src == g_lateArrays[i].src) {
+      ++j;
+    }
+    const auto& item = g_lateArrays[i];
+    if (j == i + 1 && storage != nullptr && static_cast<size_t>(item.offset) + item.size <= storageSize) {
+      std::memcpy(storage + item.offset, item.src, item.size);
+    }
+    i = j;
+  }
+  g_lateArrays.clear();
+}
 } // namespace aurora::gx::fifo
+
+void aurora_set_late_array_window(const void* lo, const void* hi) {
+  aurora::gx::fifo::g_lateArrayHi.store(static_cast<const uint8_t*>(hi), std::memory_order_relaxed);
+  aurora::gx::fifo::g_lateArrayLo.store(static_cast<const uint8_t*>(lo), std::memory_order_relaxed);
+}
