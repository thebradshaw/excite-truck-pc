# Writes OUT, a C++ file holding each font in FONTS as a byte array:
#   extern const unsigned char et_font_<name>[]; extern const unsigned int et_font_<name>_size;
# <name> is the file name without extension, lower case, with - turned into _.
set(text "// Generated by EmbedFonts.cmake. Do not edit.\n")
foreach(font IN LISTS FONTS)
    get_filename_component(name "${font}" NAME_WE)
    string(TOLOWER "${name}" name)
    string(REPLACE "-" "_" name "${name}")
    file(READ "${font}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    string(APPEND text "extern const unsigned char et_font_${name}[];\nalignas(4) const unsigned char et_font_${name}[] = {\n${bytes}\n};\n")
    string(APPEND text "extern const unsigned int et_font_${name}_size;\nconst unsigned int et_font_${name}_size = ${size};\n")
endforeach()
file(WRITE "${OUT}" "${text}")
